--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -588,7 +588,7 @@
   if (is_clang) {
     # Flags for diagnostics.
     cflags += [ "-fcolor-diagnostics" ]
-    if (!is_wasm) {
+    if (!is_wasm && false) {
       if (!is_win) {
         cflags += [ "-fdiagnostics-show-inlining-chain" ]
       } else {
@@ -629,7 +629,7 @@
     # The performance improvement does not seem worth the risk. See
     # https://crbug.com/484082200 for background and https://crrev.com/c/7593035
     # for discussion.
-    if (!is_wasm) {
+    if (!is_wasm && false) {
       cflags += [ "-fno-lifetime-dse" ]
     }
 
@@ -1590,7 +1590,7 @@
 # See also: https://crbug.com/40891132#comment10
 ubsan_hardening("c_array_bounds") {
   sanitizer = "array-bounds"
-  condition = !(is_asan && target_cpu == "x86")
+  condition = !(is_asan && target_cpu == "x86") && false
 
   # Because we've enabled array-bounds sanitizing we also want to suppress
   # the related warning about "unsafe-buffer-usage-in-static-sized-array",
@@ -1604,6 +1604,7 @@
 # `NOTREACHED()` at the end of such functions.
 ubsan_hardening("return") {
   sanitizer = "return"
+  condition = false
 }
 
 config("rustc_revision") {
@@ -2031,6 +2032,12 @@
       # should always be added for clang builds.
       cflags += [ "-Wexit-time-destructors" ]
     }
+
+    # Ignore unknown options and pragmas
+    cflags += [
+      "-Wno-unknown-warning-option",
+      "-Wno-unknown-pragmas",
+    ]
   }
 
   # TODO(crbug.com/354162568): Clean up and enable.
