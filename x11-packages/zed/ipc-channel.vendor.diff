+#[cfg(target_os = "android")]
+fn create_shmem(name: CString, length: usize) -> c_int {
+    // Bionic has no shm_open; use the memfd_create syscall directly (API < 30 has no wrapper).
+    unsafe {
+        let fd = libc::syscall(libc::SYS_memfd_create, name.as_ptr(), libc::MFD_CLOEXEC) as c_int;
+        assert!(fd >= 0);
+        assert!(libc::ftruncate(fd, length as off_t) == 0);
+        fd
+    }
+}
