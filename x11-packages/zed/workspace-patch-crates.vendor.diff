Point the workspace to the patched vendored crates.

This can not be part of android-support.patch: that one is applied before
`cargo vendor`, which fails if the vendor/ paths do not exist yet.
The crates.io entries are added to the already existing [patch.crates-io]
table, redefining the table would be a TOML error.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -983,7 +983,7 @@ features = [
 ]
 
 [patch.crates-io]
-cpal = { git = "https://github.com/RustAudio/cpal", rev = "e1612d5d98152f8dc2a62e1b51ef7cbf4f7f26b7" }
+cpal = { path = "vendor/cpal" }
 # Unify `tree_sitter_language::LanguageFn` between crates.io grammar crates and
 # the git tree-sitter above; two instances of the crate would make grammar
 # constants type-incompatible with `tree_sitter::Language`.
@@ -1012,6 +1012,23 @@ khronos-egl = { git = "https://github.com/zed-industries/khronos-egl", rev = "42
 # per-crate scratch dirs are sufficient. Upstream issue:
 # https://github.com/dtolnay/cxx/issues/1752
 scratch = { path = "tooling/corgi/patches/scratch" }
+x11rb-protocol = { path = "vendor/x11rb-protocol" }
+ipc-channel = { path = "vendor/ipc-channel" }
+wayland-cursor = { path = "vendor/wayland-cursor" }
+rustls-platform-verifier = { path = "vendor/rustls-platform-verifier" }
+wasmtime-internal-jit-icache-coherence = { path = "vendor/wasmtime-internal-jit-icache-coherence" }
+
+[patch."https://github.com/RustAudio/cpal"]
+cpal = { path = "vendor/cpal" }
+
+[patch."https://github.com/zed-industries/scap"]
+zed-scap = { path = "vendor/zed-scap" }
+
+[patch."https://github.com/zed-industries/trash-rs"]
+trash = { path = "vendor/trash" }
+
+[patch."https://github.com/zed-industries/alacritty"]
+alacritty_terminal = { path = "vendor/alacritty_terminal" }
 
 [profile.dev]
 split-debuginfo = "unpacked"
