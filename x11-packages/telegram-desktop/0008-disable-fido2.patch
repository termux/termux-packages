diff --git a/Telegram/SourceFiles/webauthn/webauthn_no_fido.cpp b/Telegram/SourceFiles/webauthn/webauthn_no_fido.cpp
new file mode 100644
--- /dev/null
+++ b/Telegram/SourceFiles/webauthn/webauthn_no_fido.cpp
@@ -0,0 +1,61 @@
+/*
+This file is part of Telegram Desktop,
+the official desktop application for the Telegram messaging service.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#include "platform/platform_webauthn.h"
+#include "webauthn/webauthn_common.h"
+
+namespace Platform::WebAuthn {
+
+bool IsSupported() {
+	return false;
+}
+
+void RegisterKey(
+		const Data::Passkey::RegisterData &,
+		Fn<void(RegisterResult)> callback) {
+	callback(RegisterResult{ .error = Error::Other });
+}
+
+void Login(
+		const Data::Passkey::LoginData &,
+		Fn<void(LoginResult)> callback) {
+	callback(LoginResult{ .error = Error::Other });
+}
+
+bool Libfido2DevicePresent() {
+	return false;
+}
+
+void RegisterViaLibfido2(
+		const Data::Passkey::RegisterData &,
+		Fn<void(RegisterResult)> callback) {
+	callback(RegisterResult{ .error = Error::Other });
+}
+
+void LoginViaLibfido2(
+		const Data::Passkey::LoginData &,
+		Fn<void(LoginResult)> callback) {
+	callback(LoginResult{ .error = Error::Other });
+}
+
+bool SecurityKeyPresent() {
+	return false;
+}
+
+void RegisterViaSecurityKey(
+		const Data::Passkey::RegisterData &,
+		Fn<void(RegisterResult)> callback) {
+	callback(RegisterResult{ .error = Error::Other });
+}
+
+void LoginViaSecurityKey(
+		const Data::Passkey::LoginData &,
+		Fn<void(LoginResult)> callback) {
+	callback(LoginResult{ .error = Error::Other });
+}
+
+} // namespace Platform::WebAuthn
