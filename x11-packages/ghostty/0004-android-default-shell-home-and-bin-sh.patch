+/// Android launchers start us with arguments and cwd "/", so "inherit"
+/// would open the terminal in "/" instead of $HOME.
+fn androidLaunchedFromLauncher() bool {
+    if (comptime !builtin.target.abi.isAndroid()) return false;
+    if (internal_os.launchedFromDesktop()) return true;
+    var buf: [std.fs.max_path_bytes]u8 = undefined;
+    const cwd = std.posix.getcwd(&buf) catch return false;
+    return std.mem.eql(u8, cwd, "/");
+}
