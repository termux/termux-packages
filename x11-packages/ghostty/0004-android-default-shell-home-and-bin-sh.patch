+                        self.command = .{ .shell = try alloc.dupeZ(u8, value) };
+                    } else |_| {}
+
+                    if (self.command == null) {
+                        log.info("default shell src=termux value=@TERMUX_PREFIX@/bin/login", .{});
+                        self.command = .{ .shell = "@TERMUX_PREFIX@/bin/login" };
