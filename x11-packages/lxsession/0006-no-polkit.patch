--- a/configure.ac
+++ b/configure.ac
@@ -65,6 +65,7 @@
   enable_gtk3="no"
   use_buildin_clipboard="no"
   use_buildin_polkit="no"
+  have_polkit="no"
 else
   AC_ARG_ENABLE([gtk3],
       AS_HELP_STRING([--enable-gtk3],
@@ -87,7 +88,21 @@
   AC_SUBST(VALA_GTK_LIBS)
 
   polkit_modules="polkit-agent-1"
-  PKG_CHECK_MODULES(POLKIT, [$polkit_modules])
+
+  AC_ARG_ENABLE(
+      [polkit],
+      AS_HELP_STRING([--disable-polkit],
+                     [disable polkit agent support (default: auto)]),
+      use_polkit="$enableval", use_polkit="auto")
+
+  if test "x$use_polkit" != "xno"; then
+    PKG_CHECK_MODULES(POLKIT, [$polkit_modules], have_polkit="yes", have_polkit="no")
+    if test "x$use_polkit" = "xyes" -a "x$have_polkit" = "xno"; then
+      AC_MSG_ERROR([polkit support requested but polkit-agent-1 not found])
+    fi
+  else
+    have_polkit="no"
+  fi
   AC_SUBST(POLKIT_CFLAGS)
   AC_SUBST(POLKIT_LIBS)
 
@@ -103,6 +118,10 @@
                      [Build with build-in polkit-agent support (default: no)]),
       use_buildin_polkit=$enableval, use_buildin_polkit="no")
 
+  if test "x$use_buildin_polkit" = "xyes" -a "x$have_polkit" = "xno"; then
+    AC_MSG_ERROR([built-in polkit support requested but polkit-agent-1 not found])
+  fi
+
   AC_ARG_ENABLE(
       [advanced-notifications],
       AS_HELP_STRING([--enable-advanced-notifications],
@@ -113,6 +132,7 @@
 
 AM_CONDITIONAL(USE_BUILDIN_CLIPBOARD, test "$use_buildin_clipboard" = "yes")
 AM_CONDITIONAL(USE_BUILDIN_POLKIT, test "$use_buildin_polkit" = "yes")
+AM_CONDITIONAL(USE_POLKIT, test "x$have_polkit" = "xyes")
 AM_CONDITIONAL(USE_GTK3, test "$enable_gtk3" = "yes")
 AM_CONDITIONAL(USE_ADVANCED_NOTIFICATIONS, test "$use_advanced_notifications" = "yes")
 
