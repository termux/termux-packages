From 4b573ce66935101e7e2e586aaefdb001c3b83f16 Mon Sep 17 00:00:00 2001
From: lumaparallax <257510328+lumaparallax@users.noreply.github.com>
Date: Tue, 24 Nov 2026 22:23:35 +0900
Subject: [PATCH 4/9] configure Bzlmod toolchains and fix TF patch

---
 MODULE.bazel                                  | 26 +++++++++++++++++++
 .../org_tensorflow_c_api_experimental.diff    |  2 +-
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/MODULE.bazel b/MODULE.bazel
index 5055a7f..0bf2a5f 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -95,3 +95,29 @@ node.toolchain(node_version = "20.14.0")
 use_repo(node, "nodejs_toolchains")
 
 register_toolchains("@nodejs_toolchains//:all")
+
+new_local_repository_ = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")
+
+new_local_repository_(
+    name = "termux-prefix",
+    path = "@TERMUX_PREFIX@",
+    build_file_content = """
+package(default_visibility = ["//visibility:public"])
+filegroup(
+    name = "prefix",
+    srcs = glob(["**"], exclude = ["share/**"])
+)
+"""
+)
+
+new_local_repository_(
+    name = "termux-toolchain",
+    path = "@TERMUX_PREFIX@/tmp/custom-toolchain",
+    build_file_content = """
+package(default_visibility = ["//visibility:public"])
+filegroup(
+    name = "toolchain",
+    srcs = glob(["**"])
+)
+"""
+)
diff --git a/third_party/org_tensorflow_c_api_experimental.diff b/third_party/org_tensorflow_c_api_experimental.diff
index 963f4ab..0e9bbf5 100644
--- a/third_party/org_tensorflow_c_api_experimental.diff
+++ b/third_party/org_tensorflow_c_api_experimental.diff
@@ -83,7 +83,7 @@ index 98ae0d425ab..fbddc684a5d 100644
      ],
      hdrs = [
          "c_api_experimental.h",
-@@ -437,17 +442,22 @@ tflite_cc_library_with_c_headers_test(
+@@ -437,15 +442,20 @@ tflite_cc_library_with_c_headers_test(
      copts = tflite_copts(),
      tags = ["allow_undefined_symbols"],  # For tflite::CreateOpResolver().
      deps = [
-- 
