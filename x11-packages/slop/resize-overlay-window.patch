 #include "xshaperectangle.hpp"
 
+namespace slop {
+// Termux:X11 resizes the X screen at runtime (for example when the Android
+// keyboard is shown or hidden). Keep the overlay window as big as the real
+// root window instead of the screen size cached when slop started.
+static void syncWindowSize( Window win ) {
+    Window junk;
+    int x, y;
+    unsigned int rootw, rooth, winw, winh, border, depth;
+    if ( !XGetGeometry( x11->display, x11->root, &junk, &x, &y, &rootw, &rooth, &border, &depth ) ) {
+        return;
+    }
+    if ( !XGetGeometry( x11->display, win, &junk, &x, &y, &winw, &winh, &border, &depth ) ) {
+        return;
+    }
+    if ( winw != rootw || winh != rooth ) {
+        XResizeWindow( x11->display, win, rootw, rooth );
+    }
+}
+}
