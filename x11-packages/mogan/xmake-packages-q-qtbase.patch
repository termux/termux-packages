xmake downloads Qt with aqt when cross-compiling. Use the Qt installed in
the build environment instead, and report the version xmake requested:
otherwise xmake rejects the installed Qt because its version differs from
the one it selected from its own list, and tries to install that one.

--- a/xmake/packages/q/qtbase/xmake.lua
+++ b/xmake/packages/q/qtbase/xmake.lua
@@ -59,7 +59,7 @@ package("qtbase")
 
     on_load(function (package)
         package:addenv("PATH", "bin")
-        if package:is_cross() then
+        if false then
             local host_qt_depname = "qt-tools"
             if package:version() then
                 host_qt_depname = host_qt_depname .. " " .. package:version():shortstr()
@@ -88,7 +88,7 @@ package("qtbase")
         if package:config("exact_version") and version then
             find_opt.version = version:shortstr()
         end
-        if not package:is_cross() then
+        if true then
             qt = find_qt(sdkdir, find_opt)
         else
             local host_qt = package:dep("qt-tools")
@@ -117,7 +117,7 @@ package("qtbase")
                 return
             end
         end
-        qt.version = qt.sdkver
+        qt.version = version and version:shortstr() or qt.sdkver
         package:data_set("qt", qt)
         return qt
     end)
