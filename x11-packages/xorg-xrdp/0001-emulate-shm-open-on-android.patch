@@ -50,6 +50,36 @@
 
 #include "rdpMisc.h"
 
+#ifdef __ANDROID__
+/* Bionic provides no POSIX shm_open/shm_unlink: emulate with tmp files. */
+static int
+shm_unlink(const char *name)
+{
+    char fname[128];
+
+    while (name[0] == '/')
+    {
+        ++name;
+    }
+    snprintf(fname, sizeof(fname), "@TERMUX_PREFIX@/tmp/%s", name);
+    return unlink(fname);
+}
+
+static int
+shm_open(const char *name, int oflag, mode_t mode)
+{
+    char fname[128];
+
+    while (name[0] == '/')
+    {
+        ++name;
+    }
+    snprintf(fname, sizeof(fname), "@TERMUX_PREFIX@/tmp/%s", name);
+    return open(fname, oflag, mode);
+}
+
+#endif
