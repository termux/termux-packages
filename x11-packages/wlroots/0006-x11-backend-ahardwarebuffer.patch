 }
 
+// termux-x11 receives an AHardwareBuffer handle over the socket passed as the
+// DRI3 buffer instead of a dma-buf fd
+#define AHB_SOCKET_MODIFIER 1256
+
+static xcb_pixmap_t import_ahb(struct wlr_x11_output *output,
+		struct wlr_ahb_buffer *buffer) {
+	struct wlr_x11_backend *x11 = output->x11;
+	const struct wlr_x11_format *x11_fmt = x11->x11_format;
+
+	if (buffer->format != x11_fmt->drm)
+		return XCB_PIXMAP_NONE;
+
+	int sockets[2];
+	if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) != 0)
+		return XCB_PIXMAP_NONE;
+
+	xcb_pixmap_t pixmap = xcb_generate_id(x11->xcb);
+	xcb_void_cookie_t cookie = xcb_dri3_pixmap_from_buffers_checked(x11->xcb,
+		pixmap, output->win, 1, buffer->base.width, buffer->base.height,
+		buffer->desc.stride * 4, 0, 0, 0, 0, 0, 0, 0, x11_fmt->depth,
+		x11_fmt->bpp, AHB_SOCKET_MODIFIER, &sockets[0]);
+	xcb_flush(x11->xcb);
+
+	struct pollfd request = { .fd = sockets[1], .events = POLLIN };
+	uint8_t byte;
+	bool sent = poll(&request, 1, 2000) == 1 &&
+		read(sockets[1], &byte, 1) == 1 &&
+		wlr_ahb_buffer_send_handle(buffer, sockets[1]);
+	close(sockets[1]);
+
+	xcb_generic_error_t *error = xcb_request_check(x11->xcb, cookie);
+	if (error != NULL || !sent) {
+		free(error);
+		return XCB_PIXMAP_NONE;
+	}
+	return pixmap;
+}
