 	xcb_dri3_open_reply_t *open_reply =
 		xcb_dri3_open_reply(x11->xcb, open_cookie, NULL);
 	if (open_reply == NULL) {
-		wlr_log(WLR_ERROR, "Failed to open DRI3");
+		wlr_log(x11->have_ahb ? WLR_DEBUG : WLR_ERROR, "Failed to open DRI3");
 		return -1;
 	}
 
