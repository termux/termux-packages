+#ifdef __TERMUX__
+static bool receive_ahb(struct wlr_dmabuf_attributes *attribs,
+		int32_t width, int32_t height, uint32_t client_format) {
+	AHardwareBuffer *handle = NULL;
+	struct pollfd pfd = { .fd = attribs->fd[0], .events = POLLIN };
+	if (!wlr_ahb_available() ||
+			send(attribs->fd[0], "", 1, MSG_NOSIGNAL) != 1 ||
+			poll(&pfd, 1, 1000) <= 0 ||
+			AHardwareBuffer_recvHandleFromUnixSocket(attribs->fd[0], &handle) != 0) {
+		return false;
+	}
+	close(attribs->fd[0]);
+	attribs->fd[0] = -1;
+
+	AHardwareBuffer_Desc desc;
+	AHardwareBuffer_describe(handle, &desc);
+
+	bool format_ok;
+	if (desc.format == 5) { // AHARDWAREBUFFER_FORMAT_B8G8R8A8_UNORM
+		format_ok = client_format == DRM_FORMAT_ARGB8888 ||
+			client_format == DRM_FORMAT_XRGB8888;
+	} else {
+		format_ok = (desc.format == AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM ||
+				desc.format == AHARDWAREBUFFER_FORMAT_R8G8B8X8_UNORM) &&
+			(client_format == DRM_FORMAT_ABGR8888 || client_format == DRM_FORMAT_XBGR8888 ||
+				client_format == DRM_FORMAT_ARGB8888 || client_format == DRM_FORMAT_XRGB8888);
+	}
+
+	bool ok = format_ok && (int32_t)desc.width >= width &&
+		(int32_t)desc.height >= height &&
+		wlr_ahb_get_dmabuf_attributes(handle, &desc, client_format, width, attribs);
+	AHardwareBuffer_release(handle);
+	return ok;
+}
+#endif
