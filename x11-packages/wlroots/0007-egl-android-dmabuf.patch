+// Android EGL drivers sometimes advertise EGL_EXT_image_dma_buf_import without
+// supporting it, and sometimes support it without advertising it. Import a real
+// buffer instead of trusting the extension string.
+static bool probe_dmabuf_import(struct wlr_egl *egl) {
+	struct wlr_allocator *allocator = wlr_ahb_allocator_create();
+	if (allocator == NULL) {
+		return false;
+	}
+
+	struct wlr_drm_format_set formats = {0};
+	wlr_drm_format_set_add(&formats, DRM_FORMAT_XRGB8888, DRM_FORMAT_MOD_LINEAR);
+	struct wlr_buffer *buffer = wlr_allocator_create_buffer(allocator, 64, 64,
+		wlr_drm_format_set_get(&formats, DRM_FORMAT_XRGB8888));
+
+	bool ok = false;
+	struct wlr_dmabuf_attributes dmabuf = {0};
+	if (buffer != NULL && wlr_buffer_get_dmabuf(buffer, &dmabuf)) {
+		bool external_only;
+		egl->exts.EXT_image_dma_buf_import = true;
+		EGLImageKHR image =
+			wlr_egl_create_image_from_dmabuf(egl, &dmabuf, &external_only);
+		if (image != EGL_NO_IMAGE_KHR) {
+			wlr_egl_destroy_image(egl, image);
+			ok = true;
+		}
+		egl->exts.EXT_image_dma_buf_import = ok;
+	}
+
+	if (buffer != NULL) {
+		wlr_buffer_drop(buffer);
+	}
+	wlr_drm_format_set_finish(&formats);
+	wlr_allocator_destroy(allocator);
+	return ok;
+}
