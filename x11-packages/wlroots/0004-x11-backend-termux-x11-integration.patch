+bool x11_has_window_manager(struct wlr_x11_backend *x11) {
+	xcb_get_property_reply_t *reply = xcb_get_property_reply(x11->xcb,
+		xcb_get_property(x11->xcb, false, x11->screen->root,
+			x11->atoms.net_supporting_wm_check, XCB_ATOM_WINDOW, 0, 1),
+		NULL);
+	if (!reply)
+		return false;
+
+	bool found = false;
+	if (reply->type == XCB_ATOM_WINDOW && reply->format == 32 &&
+			xcb_get_property_value_length(reply) >= (int)sizeof(xcb_window_t)) {
+		xcb_window_t check = *(xcb_window_t *)xcb_get_property_value(reply);
+		xcb_get_window_attributes_reply_t *attrs = xcb_get_window_attributes_reply(
+			x11->xcb, xcb_get_window_attributes(x11->xcb, check), NULL);
+		found = attrs != NULL;
+		free(attrs);
+	}
+	free(reply);
+	return found;
+}
+
+bool x11_get_root_size(struct wlr_x11_backend *x11, int32_t *width,
+		int32_t *height) {
+	xcb_get_geometry_reply_t *reply = xcb_get_geometry_reply(x11->xcb,
+		xcb_get_geometry(x11->xcb, x11->screen->root), NULL);
+	if (!reply)
+		return false;
+	*width = reply->width;
+	*height = reply->height;
+	free(reply);
+	return *width > 0 && *height > 0;
+}
+
+void x11_fit_outputs_to_root(struct wlr_x11_backend *x11) {
+	int32_t width, height;
+	if (x11_has_window_manager(x11) || !x11_get_root_size(x11, &width, &height))
+		return;
+
+	struct wlr_x11_output *output;
+	wl_list_for_each(output, &x11->outputs, link) {
+		if (output->win_width == width && output->win_height == height)
+			continue;
+		const uint32_t values[] = {0, 0, width, height};
+		xcb_configure_window(x11->xcb, output->win,
+			XCB_CONFIG_WINDOW_X | XCB_CONFIG_WINDOW_Y |
+			XCB_CONFIG_WINDOW_WIDTH | XCB_CONFIG_WINDOW_HEIGHT, values);
+	}
+	xcb_flush(x11->xcb);
+}
