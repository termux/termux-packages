+
+#define MAX_INCREMENTAL_KEYS 16
+
+static void load_mapping(struct wlr_x11_backend *x11, xcb_keycode_t first,
+		uint8_t count, bool base) {
+	xcb_get_keyboard_mapping_reply_t *reply = xcb_get_keyboard_mapping_reply(
+		x11->xcb, xcb_get_keyboard_mapping(x11->xcb, first, count), NULL);
+	if (!reply)
+		return;
+
+	int per_key = reply->keysyms_per_keycode;
+	xcb_keysym_t *keysyms = xcb_get_keyboard_mapping_keysyms(reply);
+	for (int i = 0; i < count; i++) {
+		xcb_keysym_t *syms = &keysyms[i * per_key];
+		size_t keycode = first + i;
+		if (keycode > 255)
+			break;
+
+		if (base) {
+			x11->xkb.base_defined[keycode] = false;
+			for (int j = 0; j < per_key; j++) {
+				if (syms[j] != XCB_NO_SYMBOL) {
+					x11->xkb.base_defined[keycode] = true;
+					break;
+				}
+			}
+			x11->xkb.scratch[keycode][0] = syms[0];
+			x11->xkb.scratch[keycode][1] = per_key > 1 ? syms[1] : XCB_NO_SYMBOL;
+		} else if (!x11->xkb.base_defined[keycode]) {
+			x11->xkb.sticky_scratch[keycode] = true;
+			x11->xkb.scratch[keycode][0] = syms[0];
+			x11->xkb.scratch[keycode][1] = per_key > 1 ? syms[1] : XCB_NO_SYMBOL;
+		}
+	}
+	free(reply);
+}
+
+static bool is_scratch_name(const char *name, uint32_t keycode) {
+	return name && name[0] == 'T' && isdigit((unsigned char)name[1]) &&
+		isdigit((unsigned char)name[2]) && isdigit((unsigned char)name[3]) &&
+		name[4] == '\0' && (uint32_t)atoi(name + 1) == keycode;
+}
+
+static void load_base_mapping(struct wlr_x11_backend *x11) {
+	const xcb_setup_t *setup = xcb_get_setup(x11->xcb);
+	memset(&x11->xkb.base_defined, 0, sizeof(x11->xkb.base_defined));
+	memset(&x11->xkb.scratch, 0, sizeof(x11->xkb.scratch));
+	load_mapping(x11, setup->min_keycode,
+		setup->max_keycode - setup->min_keycode + 1, true);
+
+	struct xkb_context *context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+	int32_t device = xkb_x11_get_core_keyboard_device_id(x11->xcb);
+	struct xkb_keymap *keymap = context && device >= 0 ?
+		xkb_x11_keymap_new_from_device(context, x11->xcb, device,
+			XKB_KEYMAP_COMPILE_NO_FLAGS) : NULL;
+	for (size_t keycode = setup->min_keycode; keycode <= setup->max_keycode &&
+			keycode <= 255; keycode++) {
+		bool named = x11->xkb.sticky_scratch[keycode] || (keymap &&
+			is_scratch_name(xkb_keymap_key_get_name(keymap, keycode), keycode));
+		if (named) {
+			x11->xkb.sticky_scratch[keycode] = true;
+			x11->xkb.base_defined[keycode] = false;
+		} else {
+			memset(x11->xkb.scratch[keycode], 0, sizeof(x11->xkb.scratch[keycode]));
+		}
+	}
+	xkb_keymap_unref(keymap);
+	xkb_context_unref(context);
+}
+
+static bool append_name(uint8_t *buf, size_t cap, size_t *len, const char *name) {
+	size_t n = strlen(name);
+	if (n > 255 || *len + 1 + n > cap)
+		return false;
+	buf[(*len)++] = n;
+	memcpy(buf + *len, name, n);
+	*len += n;
+	return true;
+}
+
+static void reset_server_keymap(struct wlr_x11_backend *x11) {
+	const char *layout = getenv("XKB_DEFAULT_LAYOUT");
+	const char *variant = getenv("XKB_DEFAULT_VARIANT");
+	if (layout == NULL || layout[0] == '\0') {
+		layout = "us";
+		variant = NULL;
+	}
+
+	char symbols[256];
+	snprintf(symbols, sizeof(symbols), "pc+%s%s%s%s+inet(evdev)", layout,
+		variant && variant[0] ? "(" : "", variant && variant[0] ? variant : "",
+		variant && variant[0] ? ")" : "");
+
+	uint8_t names[512];
+	size_t names_len = 0;
+	const char *components[] = {
+		"", "evdev+aliases(qwerty)", "complete", "complete", symbols, "",
+	};
+	for (size_t i = 0; i < sizeof(components) / sizeof(components[0]); i++)
+		if (!append_name(names, sizeof(names), &names_len, components[i]))
+			return;
+
+	struct {
+		uint8_t major_opcode, minor_opcode;
+		uint16_t length;
+		uint16_t device_spec, need, want;
+		uint8_t load, pad;
+	} request = {
+		.minor_opcode = XCB_XKB_GET_KBD_BY_NAME,
+		.device_spec = XCB_XKB_ID_USE_CORE_KBD,
+		.need = 0x3f, .want = 0xff, .load = 1,
+	};
+
+	uint8_t padding[3] = {0};
+	size_t padded = (names_len + 3) & ~(size_t)3;
+	struct iovec parts[5] = {
+		{ NULL, 0 }, { NULL, 0 },
+		{ &request, sizeof(request) },
+		{ names, names_len },
+		{ padding, padded - names_len },
+	};
+	xcb_protocol_request_t proto = {
+		.count = 3,
+		.ext = &xcb_xkb_id,
+		.opcode = XCB_XKB_GET_KBD_BY_NAME,
+		.isvoid = 0,
+	};
+
+	unsigned int sequence = xcb_send_request(x11->xcb, 0, &parts[2], &proto);
+	xcb_generic_error_t *error = NULL;
+	void *reply = xcb_wait_for_reply(x11->xcb, sequence, &error);
+	if (error) {
+		wlr_log(WLR_ERROR, "Failed to reset X11 keymap (error %d)", error->error_code);
+		free(error);
+	}
+	free(reply);
+}
+
+void x11_xkb_init(struct wlr_x11_backend *x11) {
+	const xcb_query_extension_reply_t *ext =
+		xcb_get_extension_data(x11->xcb, &xcb_xkb_id);
+	if (!ext || !ext->present)
+		return;
+
+	xcb_xkb_use_extension_reply_t *reply = xcb_xkb_use_extension_reply(
+		x11->xcb, xcb_xkb_use_extension(x11->xcb, 1, 0), NULL);
+	if (!reply || !reply->supported) {
+		free(reply);
+		return;
+	}
+	free(reply);
+
+	x11->xkb.first_event = ext->first_event;
+	if (!x11_has_window_manager(x11) && !getenv("WLR_X11_KEEP_KEYMAP"))
+		reset_server_keymap(x11);
+	memset(&x11->xkb.sticky_scratch, 0, sizeof(x11->xkb.sticky_scratch));
+	load_base_mapping(x11);
+
+	xcb_xkb_select_events(x11->xcb, XCB_XKB_ID_USE_CORE_KBD,
+		XCB_XKB_EVENT_TYPE_MAP_NOTIFY | XCB_XKB_EVENT_TYPE_NEW_KEYBOARD_NOTIFY,
+		0, XCB_XKB_EVENT_TYPE_NEW_KEYBOARD_NOTIFY,
+		XCB_XKB_MAP_PART_KEY_SYMS, XCB_XKB_MAP_PART_KEY_SYMS, NULL);
+	x11->xkb.enabled = true;
+}
+
+bool x11_xkb_handle_event(struct wlr_x11_backend *x11,
+		xcb_generic_event_t *event) {
+	if (!x11->xkb.enabled ||
+		(event->response_type & XCB_EVENT_RESPONSE_TYPE_MASK) != x11->xkb.first_event)
+		return false;
+
+	uint8_t type = ((uint8_t *)event)[1];
+	if (type == XCB_XKB_MAP_NOTIFY) {
+		xcb_xkb_map_notify_event_t *ev = (xcb_xkb_map_notify_event_t *)event;
+		if (!(ev->changed & XCB_XKB_MAP_PART_KEY_SYMS))
+			return true;
+		if (ev->nKeySyms > MAX_INCREMENTAL_KEYS)
+			load_base_mapping(x11);
+		else
+			load_mapping(x11, ev->firstKeySym, ev->nKeySyms, false);
+	} else if (type == XCB_XKB_NEW_KEYBOARD_NOTIFY) {
+		load_base_mapping(x11);
+	}
+	return true;
+}
+
+static void text_input_sync_focus(struct wlr_x11_backend *x11) {
+	struct x11_text_input *ti = &x11->text_input;
+	struct wlr_surface *focused = ti->seat->keyboard_state.focused_surface;
+
+	struct wlr_text_input_v3 *input;
+	wl_list_for_each(input, &ti->manager->text_inputs, link) {
+		if (input->seat != ti->seat)
+			continue;
+
+		struct wlr_surface *wanted = NULL;
+		if (focused && wl_resource_get_client(input->resource) == wl_resource_get_client(focused->resource))
+			wanted = focused;
+
+		if (input->focused_surface == wanted)
+			continue;
+		if (input->focused_surface)
+			wlr_text_input_v3_send_leave(input);
+		if (wanted)
+			wlr_text_input_v3_send_enter(input, wanted);
+	}
+}
+
+static void handle_text_input_event(struct wl_listener *listener, void *data) {
+	struct wlr_x11_backend *x11 = wl_container_of(listener, x11, text_input.new_text_input);
+	text_input_sync_focus(x11);
+}
+
+static void handle_focus_change(struct wl_listener *listener, void *data) {
+	struct wlr_x11_backend *x11 = wl_container_of(listener, x11, text_input.focus_change);
+	text_input_sync_focus(x11);
+}
+
+static void text_input_stop(struct wlr_x11_backend *x11) {
+	struct x11_text_input *ti = &x11->text_input;
+	if (!ti->active)
+		return;
+	wl_list_remove(&ti->new_text_input.link);
+	wl_list_remove(&ti->manager_destroy.link);
+	wl_list_remove(&ti->focus_change.link);
+	wl_list_remove(&ti->seat_destroy.link);
+	ti->active = false;
+}
+
+static void handle_manager_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_x11_backend *x11 = wl_container_of(listener, x11, text_input.manager_destroy);
+	text_input_stop(x11);
+	x11->text_input.manager = NULL;
+}
+
+static void handle_text_input_seat_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_x11_backend *x11 = wl_container_of(listener, x11, text_input.seat_destroy);
+	text_input_stop(x11);
+	x11->text_input.seat = NULL;
+}
+
+static void text_input_start(struct wlr_x11_backend *x11) {
+	struct x11_text_input *ti = &x11->text_input;
+	if (ti->active || ti->manager == NULL || ti->seat == NULL)
+		return;
+
+	ti->new_text_input.notify = handle_text_input_event;
+	wl_signal_add(&ti->manager->events.new_text_input, &ti->new_text_input);
+	ti->manager_destroy.notify = handle_manager_destroy;
+	wl_signal_add(&ti->manager->events.destroy, &ti->manager_destroy);
+	ti->focus_change.notify = handle_focus_change;
+	wl_signal_add(&ti->seat->keyboard_state.events.focus_change, &ti->focus_change);
+	ti->seat_destroy.notify = handle_text_input_seat_destroy;
+	wl_signal_add(&ti->seat->events.destroy, &ti->seat_destroy);
+	ti->active = true;
+
+	text_input_sync_focus(x11);
+}
+
+void x11_text_input_attach_seat(struct wlr_x11_backend *x11,
+		struct wlr_seat *seat) {
+	if (x11->text_input.seat == NULL) {
+		x11->text_input.seat = seat;
+		text_input_start(x11);
+	}
+}
+
+void x11_text_input_attach_manager(struct wlr_x11_backend *x11,
+		struct wlr_text_input_manager_v3 *manager) {
+	if (x11->text_input.manager == NULL) {
+		x11->text_input.manager = manager;
+		text_input_start(x11);
+	}
+}
+
+void x11_text_input_finish(struct wlr_x11_backend *x11) {
+	text_input_stop(x11);
+}
+
+static bool commit_text(struct wlr_x11_backend *x11, const char *text) {
+	struct wlr_text_input_manager_v3 *manager = x11->text_input.manager;
+	if (manager == NULL)
+		return false;
+
+	struct wlr_text_input_v3 *input;
+	wl_list_for_each(input, &manager->text_inputs, link) {
+		if (input->focused_surface == NULL || !input->current_enabled)
+			continue;
+		wlr_text_input_v3_send_commit_string(input, text);
+		wlr_text_input_v3_send_done(input);
+		return true;
+	}
+	return false;
+}
+
+bool x11_xkb_filter_key(struct wlr_x11_backend *x11, uint32_t keycode,
+	bool pressed, uint32_t effective_mods) {
+	if (!x11->xkb.enabled || keycode > 255)
+		return false;
+
+	if (!pressed) {
+		bool was_down = x11->xkb.scratch_down[keycode];
+		x11->xkb.scratch_down[keycode] = false;
+		return was_down;
+	}
+
+	xkb_keysym_t *syms = x11->xkb.scratch[keycode];
+	if (syms[0] == XCB_NO_SYMBOL)
+		return false;
+
+	x11->xkb.scratch_down[keycode] = true;
+
+	bool shifted = effective_mods & (XCB_MOD_MASK_SHIFT | XCB_MOD_MASK_LOCK);
+	xkb_keysym_t sym = shifted && syms[1] != XCB_NO_SYMBOL ? syms[1] : syms[0];
+
+	char text[8];
+	if (xkb_keysym_to_utf8(sym, text, sizeof(text)) <= 1)
+		return true;
+	if (!commit_text(x11, text))
+		wlr_log(WLR_DEBUG, "No enabled text-input for keysym 0x%x", sym);
+	return true;
+}
