+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <xcb/xcb.h>
+#include <xcb/xfixes.h>
+#include <wlr/types/wlr_data_device.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/util/log.h>
+#include "backend/x11.h"
+
+#define TRANSFER_TIMEOUT_MS 5000
+
+struct x11_mime {
+	char *name;
+	xcb_atom_t atom;
+};
+
+struct x11_data_source {
+	struct wlr_data_source base;
+	struct wlr_x11_backend *x11;
+	struct x11_mime *mimes;
+	size_t n_mimes;
+};
+
+struct x11_transfer {
+	struct wl_list link;
+	struct wlr_x11_backend *x11;
+	bool to_wayland;
+
+	int fd;
+	struct wl_event_source *fd_source;
+	struct wl_event_source *timer;
+
+	char *buf;
+	size_t len, cap, off;
+
+	xcb_atom_t property;
+	xcb_window_t requestor;
+	xcb_atom_t selection, target, reply_type;
+	xcb_timestamp_t time;
+};
+
+static const struct wlr_data_source_impl x_source_impl;
+
+static xcb_atom_t intern_atom(struct wlr_x11_backend *x11, const char *name) {
+	xcb_intern_atom_reply_t *reply = xcb_intern_atom_reply(x11->xcb,
+		xcb_intern_atom(x11->xcb, false, strlen(name), name), NULL);
+	if (!reply)
+		return XCB_ATOM_NONE;
+	xcb_atom_t atom = reply->atom;
+	free(reply);
+	return atom;
+}
+
+static char *atom_name(struct wlr_x11_backend *x11, xcb_atom_t atom) {
+	xcb_get_atom_name_reply_t *reply = xcb_get_atom_name_reply(x11->xcb,
+		xcb_get_atom_name(x11->xcb, atom), NULL);
+	if (!reply)
+		return NULL;
+	char *name = strndup(xcb_get_atom_name_name(reply),
+		xcb_get_atom_name_name_length(reply));
+	free(reply);
+	return name;
+}
+
+static void send_notify(struct wlr_x11_backend *x11, xcb_window_t requestor,
+		xcb_atom_t selection, xcb_atom_t target, xcb_atom_t property,
+		xcb_timestamp_t time) {
+	xcb_selection_notify_event_t ev = {
+		.response_type = XCB_SELECTION_NOTIFY,
+		.time = time,
+		.requestor = requestor,
+		.selection = selection,
+		.target = target,
+		.property = property,
+	};
+	xcb_send_event(x11->xcb, false, requestor, XCB_EVENT_MASK_NO_EVENT,
+		(const char *)&ev);
+	xcb_flush(x11->xcb);
+}
+
+static void transfer_destroy(struct x11_transfer *t) {
+	wl_list_remove(&t->link);
+	if (t->fd_source)
+		wl_event_source_remove(t->fd_source);
+	if (t->timer)
+		wl_event_source_remove(t->timer);
+	if (t->fd >= 0)
+		close(t->fd);
+	free(t->buf);
+	free(t);
+}
+
+static struct x11_transfer *transfer_create(struct wlr_x11_backend *x11,
+		bool to_wayland) {
+	struct x11_transfer *t = calloc(1, sizeof(*t));
+	if (!t)
+		return NULL;
+	t->x11 = x11;
+	t->to_wayland = to_wayland;
+	t->fd = -1;
+	wl_list_insert(&x11->sel.transfers, &t->link);
+	return t;
+}
+
+static int transfer_timeout(void *data) {
+	struct x11_transfer *t = data;
+	wlr_log(WLR_DEBUG, "Selection transfer timed out");
+	if (!t->to_wayland)
+		send_notify(t->x11, t->requestor, t->selection, t->target,
+			XCB_ATOM_NONE, t->time);
+	transfer_destroy(t);
+	return 0;
+}
+
+static void transfer_arm_timer(struct x11_transfer *t) {
+	t->timer = wl_event_loop_add_timer(t->x11->event_loop, transfer_timeout, t);
+	if (t->timer)
+		wl_event_source_timer_update(t->timer, TRANSFER_TIMEOUT_MS);
+}
+
+/* X11 -> Wayland: write the converted data into the client's pipe. */
+
+static int write_to_client(int fd, uint32_t mask, void *data) {
+	struct x11_transfer *t = data;
+	while (t->off < t->len) {
+		ssize_t n = write(t->fd, t->buf + t->off, t->len - t->off);
+		if (n < 0) {
+			if (errno == EAGAIN || errno == EINTR)
+				return 0;
+			break;
+		}
+		t->off += n;
+	}
+	transfer_destroy(t);
+	return 0;
+}
+
+static void start_write_to_client(struct x11_transfer *t) {
+	fcntl(t->fd, F_SETFL, fcntl(t->fd, F_GETFL) | O_NONBLOCK);
+	t->fd_source = wl_event_loop_add_fd(t->x11->event_loop, t->fd,
+		WL_EVENT_WRITABLE, write_to_client, t);
+	if (!t->fd_source) {
+		transfer_destroy(t);
+		return;
+	}
+	write_to_client(t->fd, WL_EVENT_WRITABLE, t);
+}
+
+static struct x11_transfer *find_transfer_by_property(
+		struct wlr_x11_backend *x11, xcb_atom_t property) {
+	struct x11_transfer *t;
+	wl_list_for_each(t, &x11->sel.transfers, link) {
+		if (t->to_wayland && t->property == property)
+			return t;
+	}
+	return NULL;
+}
+
+static void x_source_send(struct wlr_data_source *wlr_source,
+		const char *mime_type, int32_t fd) {
+	struct x11_data_source *source = wl_container_of(wlr_source, source, base);
+	struct wlr_x11_backend *x11 = source->x11;
+
+	xcb_atom_t target = XCB_ATOM_NONE;
+	for (size_t i = 0; i < source->n_mimes; i++) {
+		if (strcmp(source->mimes[i].name, mime_type) == 0) {
+			target = source->mimes[i].atom;
+			break;
+		}
+	}
+
+	struct x11_transfer *t = target != XCB_ATOM_NONE ?
+		transfer_create(x11, true) : NULL;
+	if (!t) {
+		close(fd);
+		return;
+	}
+
+	char name[48];
+	snprintf(name, sizeof(name), "WLR_X11_TRANSFER_%u", x11->sel.next_property++);
+	t->fd = fd;
+	t->property = intern_atom(x11, name);
+	transfer_arm_timer(t);
+	xcb_convert_selection(x11->xcb, x11->sel.win, x11->sel.clipboard, target,
+		t->property, XCB_CURRENT_TIME);
+	xcb_flush(x11->xcb);
+}
+
+static void x_source_destroy(struct wlr_data_source *wlr_source) {
+	struct x11_data_source *source = wl_container_of(wlr_source, source, base);
+	if (source->x11->sel.x_source == source)
+		source->x11->sel.x_source = NULL;
+	for (size_t i = 0; i < source->n_mimes; i++)
+		free(source->mimes[i].name);
+	free(source->mimes);
+	free(source);
+}
+
+static const struct wlr_data_source_impl x_source_impl = {
+	.send = x_source_send,
+	.destroy = x_source_destroy,
+};
+
+static void x_source_add_mime(struct x11_data_source *source, const char *name,
+	xcb_atom_t atom) {
+	for (size_t i = 0; i < source->n_mimes; i++)
+		if (strcmp(source->mimes[i].name, name) == 0)
+			return;
+
+	struct x11_mime *mimes = realloc(source->mimes,
+		(source->n_mimes + 1) * sizeof(*mimes));
+	char **slot = wl_array_add(&source->base.mime_types, sizeof(*slot));
+	if (!mimes || !slot)
+		return;
+	source->mimes = mimes;
+	source->mimes[source->n_mimes].name = strdup(name);
+	source->mimes[source->n_mimes].atom = atom;
+	*slot = strdup(name);
+	source->n_mimes++;
+}
+
+static void handle_targets(struct wlr_x11_backend *x11, xcb_atom_t property) {
+	struct x11_selection *sel = &x11->sel;
+
+	xcb_get_property_reply_t *reply = xcb_get_property_reply(x11->xcb,
+		xcb_get_property(x11->xcb, true, sel->win, property,
+			XCB_ATOM_ATOM, 0, 4096), NULL);
+	if (!reply || reply->type != XCB_ATOM_ATOM || reply->format != 32) {
+		free(reply);
+		return;
+	}
+
+	struct x11_data_source *source = calloc(1, sizeof(*source));
+	if (!source) {
+		free(reply);
+		return;
+	}
+	wlr_data_source_init(&source->base, &x_source_impl);
+	source->x11 = x11;
+
+	xcb_atom_t *atoms = xcb_get_property_value(reply);
+	int n = xcb_get_property_value_length(reply) / sizeof(*atoms);
+	bool has_utf8 = false, has_string = false;
+	for (int i = 0; i < n; i++) {
+		has_utf8 |= atoms[i] == sel->utf8_string;
+		has_string |= atoms[i] == sel->string;
+	}
+
+	if (has_utf8)
+		x_source_add_mime(source, "text/plain;charset=utf-8", sel->utf8_string);
+	if (has_string || has_utf8)
+		x_source_add_mime(source, "text/plain",
+			has_string ? sel->string : sel->utf8_string);
+	for (int i = 0; i < n; i++) {
+		char *name = atom_name(x11, atoms[i]);
+		if (name && strchr(name, '/'))
+			x_source_add_mime(source, name, atoms[i]);
+		free(name);
+	}
+	free(reply);
+
+	if (source->n_mimes == 0) {
+		wlr_data_source_destroy(&source->base);
+		return;
+	}
+
+	sel->x_source = source;
+	wlr_seat_set_selection(sel->seat, &source->base,
+		wl_display_next_serial(sel->seat->display));
+}
+
+static void handle_selection_notify(struct wlr_x11_backend *x11,
+		xcb_selection_notify_event_t *ev) {
+	struct x11_selection *sel = &x11->sel;
+	if (ev->requestor != sel->win)
+		return;
+
+	if (ev->property == sel->targets_property) {
+		if (ev->property != XCB_ATOM_NONE)
+			handle_targets(x11, ev->property);
+		return;
+	}
+
+	struct x11_transfer *t = find_transfer_by_property(x11, ev->property);
+	if (!t)
+		return;
+
+	xcb_get_property_reply_t *reply = xcb_get_property_reply(x11->xcb,
+		xcb_get_property(x11->xcb, true, sel->win, ev->property,
+			XCB_GET_PROPERTY_TYPE_ANY, 0, sel->max_property_bytes / 4), NULL);
+	if (!reply || reply->type == sel->incr) {
+		free(reply);
+		transfer_destroy(t);
+		return;
+	}
+
+	int len = xcb_get_property_value_length(reply);
+	t->buf = malloc(len > 0 ? len : 1);
+	if (!t->buf) {
+		free(reply);
+		transfer_destroy(t);
+		return;
+	}
+	memcpy(t->buf, xcb_get_property_value(reply), len);
+	t->len = len;
+	free(reply);
+
+	if (t->timer) {
+		wl_event_source_remove(t->timer);
+		t->timer = NULL;
+	}
+	start_write_to_client(t);
+}
+
+/* Wayland -> X11: serve SelectionRequest from the seat selection. */
+
+static const char *source_mime(struct wlr_data_source *source,
+		const char *a, const char *b) {
+	char **mime;
+	wl_array_for_each(mime, &source->mime_types) {
+		if (strcmp(*mime, a) == 0 || (b && strcmp(*mime, b) == 0))
+			return *mime;
+	}
+	return NULL;
+}
+
+static const char *mime_for_target(struct wlr_x11_backend *x11,
+		xcb_atom_t target, char **owned_name) {
+	struct x11_selection *sel = &x11->sel;
+	struct wlr_data_source *source = sel->wl_source;
+	*owned_name = NULL;
+
+	if (target == sel->utf8_string)
+		return source_mime(source, "text/plain;charset=utf-8", "text/plain");
+	if (target == sel->string || target == sel->text)
+		return source_mime(source, "text/plain", "text/plain;charset=utf-8");
+
+	*owned_name = atom_name(x11, target);
+	if (*owned_name && strchr(*owned_name, '/'))
+		return source_mime(source, *owned_name, NULL);
+	return NULL;
+}
+
+static int read_from_client(int fd, uint32_t mask, void *data) {
+	struct x11_transfer *t = data;
+	struct wlr_x11_backend *x11 = t->x11;
+
+	for (;;) {
+		if (t->len == t->cap) {
+			size_t cap = t->cap ? t->cap * 2 : 4096;
+			if (cap > x11->sel.max_property_bytes)
+				goto fail;
+			char *buf = realloc(t->buf, cap);
+			if (!buf)
+				goto fail;
+			t->buf = buf;
+			t->cap = cap;
+		}
+
+		ssize_t n = read(t->fd, t->buf + t->len, t->cap - t->len);
+		if (n < 0) {
+			if (errno == EAGAIN || errno == EINTR)
+				return 0;
+			goto fail;
+		}
+		if (n == 0)
+			break;
+		t->len += n;
+	}
+
+	xcb_change_property(x11->xcb, XCB_PROP_MODE_REPLACE, t->requestor,
+		t->property, t->reply_type, 8, t->len, t->buf);
+	send_notify(x11, t->requestor, t->selection, t->target, t->property, t->time);
+	transfer_destroy(t);
+	return 0;
+
+fail:
+	send_notify(x11, t->requestor, t->selection, t->target, XCB_ATOM_NONE, t->time);
+	transfer_destroy(t);
+	return 0;
+}
+
+static void handle_selection_request(struct wlr_x11_backend *x11,
+		xcb_selection_request_event_t *req) {
+	struct x11_selection *sel = &x11->sel;
+	xcb_atom_t property = req->property != XCB_ATOM_NONE ? req->property : req->target;
+
+	if (req->selection != sel->clipboard || !sel->owner || !sel->wl_source) {
+		send_notify(x11, req->requestor, req->selection, req->target,
+			XCB_ATOM_NONE, req->time);
+		return;
+	}
+
+	if (req->target == sel->targets) {
+		xcb_atom_t atoms[64];
+		size_t n = 0;
+		atoms[n++] = sel->targets;
+		atoms[n++] = sel->timestamp;
+		if (source_mime(sel->wl_source, "text/plain;charset=utf-8", "text/plain")) {
+			atoms[n++] = sel->utf8_string;
+			atoms[n++] = sel->string;
+			atoms[n++] = sel->text;
+		}
+		char **mime;
+		wl_array_for_each(mime, &sel->wl_source->mime_types) {
+			if (n < 64 && strchr(*mime, '/') && strncmp(*mime, "text/plain", 10) != 0) {
+				xcb_atom_t atom = intern_atom(x11, *mime);
+				if (atom != XCB_ATOM_NONE)
+					atoms[n++] = atom;
+			}
+		}
+		xcb_change_property(x11->xcb, XCB_PROP_MODE_REPLACE, req->requestor,
+			property, XCB_ATOM_ATOM, 32, n, atoms);
+		send_notify(x11, req->requestor, req->selection, req->target, property,
+			req->time);
+		return;
+	}
+
+	if (req->target == sel->timestamp) {
+		uint32_t time = req->time;
+		xcb_change_property(x11->xcb, XCB_PROP_MODE_REPLACE, req->requestor,
+			property, XCB_ATOM_INTEGER, 32, 1, &time);
+		send_notify(x11, req->requestor, req->selection, req->target, property,
+			req->time);
+		return;
+	}
+
+	char *name;
+	const char *mime = mime_for_target(x11, req->target, &name);
+	free(name);
+	struct x11_transfer *t = mime ? transfer_create(x11, false) : NULL;
+	int fds[2];
+	if (!t || pipe2(fds, O_CLOEXEC) != 0) {
+		if (t)
+			transfer_destroy(t);
+		send_notify(x11, req->requestor, req->selection, req->target,
+			XCB_ATOM_NONE, req->time);
+		return;
+	}
+
+	fcntl(fds[0], F_SETFL, fcntl(fds[0], F_GETFL) | O_NONBLOCK);
+	t->fd = fds[0];
+	t->requestor = req->requestor;
+	t->selection = req->selection;
+	t->target = req->target;
+	t->property = property;
+	t->time = req->time;
+	t->reply_type = req->target == sel->utf8_string || req->target == sel->string ?
+		req->target : req->target == sel->text ? sel->utf8_string : req->target;
+	t->fd_source = wl_event_loop_add_fd(x11->event_loop, t->fd, WL_EVENT_READABLE,
+		read_from_client, t);
+	transfer_arm_timer(t);
+	wlr_data_source_send(sel->wl_source, mime, fds[1]);
+}
+
+/* Seat selection tracking. */
+
+static void release_x_selection(struct wlr_x11_backend *x11) {
+	struct x11_selection *sel = &x11->sel;
+	if (sel->owner) {
+		xcb_set_selection_owner(x11->xcb, XCB_NONE, sel->clipboard, XCB_CURRENT_TIME);
+		xcb_flush(x11->xcb);
+		sel->owner = false;
+	}
+}
+
+static void handle_wl_source_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_x11_backend *x11 = wl_container_of(listener, x11, sel.wl_source_destroy);
+	wl_list_remove(&x11->sel.wl_source_destroy.link);
+	x11->sel.wl_source = NULL;
+}
+
+static void handle_seat_set_selection(struct wl_listener *listener, void *data) {
+	struct wlr_x11_backend *x11 = wl_container_of(listener, x11, sel.seat_set_selection);
+	struct x11_selection *sel = &x11->sel;
+	struct wlr_data_source *source = sel->seat->selection_source;
+
+	if (sel->wl_source) {
+		wl_list_remove(&sel->wl_source_destroy.link);
+		sel->wl_source = NULL;
+	}
+
+	if (source == NULL) {
+		release_x_selection(x11);
+		return;
+	}
+
+	if (source->impl == &x_source_impl)
+		return;
+
+	sel->wl_source = source;
+	sel->wl_source_destroy.notify = handle_wl_source_destroy;
+	wl_signal_add(&source->events.destroy, &sel->wl_source_destroy);
+
+	xcb_set_selection_owner(x11->xcb, sel->win, sel->clipboard, XCB_CURRENT_TIME);
+	xcb_flush(x11->xcb);
+	sel->owner = true;
+}
+
+static void handle_seat_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_x11_backend *x11 = wl_container_of(listener, x11, sel.seat_destroy);
+	struct x11_selection *sel = &x11->sel;
+	wl_list_remove(&sel->seat_set_selection.link);
+	wl_list_remove(&sel->seat_destroy.link);
+	if (sel->wl_source) {
+		wl_list_remove(&sel->wl_source_destroy.link);
+		sel->wl_source = NULL;
+	}
+	sel->seat = NULL;
+}
+
+static void handle_owner_change(struct wlr_x11_backend *x11, xcb_window_t owner) {
+	struct x11_selection *sel = &x11->sel;
+	if (owner == sel->win)
+		return;
+
+	sel->owner = false;
+
+	if (owner == XCB_NONE) {
+		if (sel->x_source && sel->seat->selection_source == &sel->x_source->base)
+			wlr_seat_set_selection(sel->seat, NULL,
+				wl_display_next_serial(sel->seat->display));
+		return;
+	}
+
+	xcb_convert_selection(x11->xcb, sel->win, sel->clipboard, sel->targets,
+		sel->targets_property, XCB_CURRENT_TIME);
+	xcb_flush(x11->xcb);
+}
+
+bool x11_selection_handle_event(struct wlr_x11_backend *x11,
+		xcb_generic_event_t *event) {
+	struct x11_selection *sel = &x11->sel;
+	if (!sel->seat)
+		return false;
+
+	uint8_t type = event->response_type & XCB_EVENT_RESPONSE_TYPE_MASK;
+	if (type == sel->xfixes_first_event + XCB_XFIXES_SELECTION_NOTIFY) {
+		xcb_xfixes_selection_notify_event_t *ev =
+			(xcb_xfixes_selection_notify_event_t *)event;
+		if (ev->selection == sel->clipboard)
+			handle_owner_change(x11, ev->owner);
+		return true;
+	}
+
+	switch (type) {
+	case XCB_SELECTION_NOTIFY:
+		handle_selection_notify(x11, (xcb_selection_notify_event_t *)event);
+		return true;
+	case XCB_SELECTION_REQUEST:
+		handle_selection_request(x11, (xcb_selection_request_event_t *)event);
+		return true;
+	case XCB_SELECTION_CLEAR:
+		sel->owner = false;
+		return true;
+	}
+	return false;
+}
+
+void x11_selection_init(struct wlr_x11_backend *x11) {
+	struct x11_selection *sel = &x11->sel;
+	wl_list_init(&sel->transfers);
+}
+
+void x11_selection_finish(struct wlr_x11_backend *x11) {
+	struct x11_selection *sel = &x11->sel;
+	struct x11_transfer *t, *tmp;
+	wl_list_for_each_safe(t, tmp, &sel->transfers, link) {
+		transfer_destroy(t);
+	}
+	if (sel->seat) {
+		wl_list_remove(&sel->seat_set_selection.link);
+		wl_list_remove(&sel->seat_destroy.link);
+		if (sel->wl_source)
+			wl_list_remove(&sel->wl_source_destroy.link);
+		sel->seat = NULL;
+	}
+}
+
+void x11_selection_attach_seat(struct wlr_x11_backend *x11,
+		struct wlr_seat *seat) {
+	struct x11_selection *sel = &x11->sel;
+	if (sel->seat)
+		return;
+
+	const xcb_query_extension_reply_t *ext =
+		xcb_get_extension_data(x11->xcb, &xcb_xfixes_id);
+	if (!ext || !ext->present)
+		return;
+	sel->xfixes_first_event = ext->first_event;
+
+	sel->clipboard = intern_atom(x11, "CLIPBOARD");
+	sel->targets = intern_atom(x11, "TARGETS");
+	sel->timestamp = intern_atom(x11, "TIMESTAMP");
+	sel->utf8_string = x11->atoms.utf8_string;
+	sel->string = XCB_ATOM_STRING;
+	sel->text = intern_atom(x11, "TEXT");
+	sel->incr = intern_atom(x11, "INCR");
+	sel->targets_property = intern_atom(x11, "WLR_X11_TARGETS");
+	sel->max_property_bytes = (size_t)xcb_get_maximum_request_length(x11->xcb) * 4 - 1024;
+
+	sel->win = xcb_generate_id(x11->xcb);
+	xcb_create_window(x11->xcb, XCB_COPY_FROM_PARENT, sel->win, x11->screen->root,
+		0, 0, 1, 1, 0, XCB_WINDOW_CLASS_INPUT_ONLY, XCB_COPY_FROM_PARENT, 0, NULL);
+
+	sel->seat = seat;
+	sel->seat_set_selection.notify = handle_seat_set_selection;
+	wl_signal_add(&seat->events.set_selection, &sel->seat_set_selection);
+	sel->seat_destroy.notify = handle_seat_destroy;
+	wl_signal_add(&seat->events.destroy, &sel->seat_destroy);
+
+	xcb_xfixes_select_selection_input(x11->xcb, sel->win, sel->clipboard,
+		XCB_XFIXES_SELECTION_EVENT_MASK_SET_SELECTION_OWNER |
+		XCB_XFIXES_SELECTION_EVENT_MASK_SELECTION_WINDOW_DESTROY |
+		XCB_XFIXES_SELECTION_EVENT_MASK_SELECTION_CLIENT_CLOSE);
+
+	xcb_get_selection_owner_reply_t *owner = xcb_get_selection_owner_reply(x11->xcb,
+		xcb_get_selection_owner(x11->xcb, sel->clipboard), NULL);
+	if (owner) {
+		if (owner->owner != XCB_NONE)
+			handle_owner_change(x11, owner->owner);
+		free(owner);
+	}
+	xcb_flush(x11->xcb);
+}
