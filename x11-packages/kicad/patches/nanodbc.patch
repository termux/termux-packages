+// Termux's unixODBC is built with SQL_WCHART_CONVERT, so WCHAR (and therefore
+// SQLWCHAR / NANODBC_SQLCHAR) is 'unsigned short'. libc++ ships no
+// std::char_traits specialization for that type, so count the terminator by hand
+// instead of going through std::char_traits.
 template <std::size_t N>
 inline std::size_t size(NANODBC_SQLCHAR const (&array)[N]) noexcept
 {
-    auto const n = std::char_traits<NANODBC_SQLCHAR>::length(array);
+    std::size_t n = 0;
+    while (n < N && array[n] != 0)
+        ++n;
     NANODBC_ASSERT(n < N);
     return n < N ? n : N - 1;
 }
