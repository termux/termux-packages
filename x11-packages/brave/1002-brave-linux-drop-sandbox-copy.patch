Stop the brave group from copying chrome_sandbox; the setuid sandbox is not built on Termux.
The copy_sandbox target itself is kept: brave's installer targets (strip_chrome_sandbox,
deb/rpm) list brave_sandbox as an input, and gn fails with "Input to targets not
generated by a dependency" if nothing generates it. It is never built, because only
chrome, chrome_crashpad_handler and brave:packed_resources are requested.

diff --git a/brave/build/linux/BUILD.gn b/brave/build/linux/BUILD.gn
--- a/brave/build/linux/BUILD.gn
+++ b/brave/build/linux/BUILD.gn
@@ -8,10 +8,7 @@
 assert(is_linux)
 
 group("brave") {
-  public_deps = [
-    ":copy_exe",
-    ":copy_sandbox",
-  ]
+  public_deps = [ ":copy_exe" ]
 }
 
 copy("copy_exe") {
