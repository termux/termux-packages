+
+void xwl_text_input_manager_init(struct xwl_screen *xwl_screen, uint32_t id,
+                                 uint32_t version);
+void xwl_text_input_seat_init(struct xwl_seat *xwl_seat);
+void xwl_text_input_seat_release(struct xwl_seat *xwl_seat);
+
+#endif
