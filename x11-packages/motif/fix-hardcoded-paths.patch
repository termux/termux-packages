Use the Termux prefix for the shell fallback of mwm and the default UIL include directory.

--- a/clients/mwm/WmFunction.c
+++ b/clients/mwm/WmFunction.c
@@ -1112,7 +1112,7 @@ Boolean F_Exec (String args, ClientData *pCD, XEvent *event)
 #ifdef SVR4
         execl ("/usr/bin/sh", "sh", "-c", args, NULL);
 #else
-        execl ("/bin/sh", "sh", "-c", args, NULL);
+        execl ("@TERMUX_PREFIX@/bin/sh", "sh", "-c", args, NULL);
 #endif
 
 
--- a/clients/uil/UilSrcSrc.c
+++ b/clients/uil/UilSrcSrc.c
@@ -637,7 +637,7 @@ open_source_file( const char           *c_file_name,
 	az_fcb->az_file_ptr = fopen(c_file_name, "r");
 
     } else {
-	static const char	c_include_dir[]= "/usr/include/";
+	static const char	c_include_dir[]= "@TERMUX_PREFIX@/include/";
 	Boolean			search_user_include=True;
 	Boolean			specific_directory=False;
 
