#!/bin/bash
# Randomise buildorder.py test on packages directory

export TERMUX_SCRIPTDIR
TERMUX_SCRIPTDIR=$(realpath "$(dirname "$0")/../..") # Root of repository.

export TERMUX_ARCH="${TERMUX_ARCH:-}"

cd "${TERMUX_SCRIPTDIR}" || exit 1

repos="$(jq -r 'del(.pkg_format) | keys | .[]' repo.json)"
if [[ -z "${repos}" ]]; then
	echo "ERROR: missing repo data" 1>&2
	exit 1
fi

for repo in ${repos}; do
	echo "INFO: Checking repo = ${repo} (${TERMUX_ARCH})"
	no_of_total_packages=0
	no_of_filter_packages=0

	total_packages="$(find "${repo}" -mindepth 1 -maxdepth 1 -type d | sort)"
	filter_packages="${total_packages}"
	if [[ -n "${TERMUX_ARCH}" ]]; then
		filter_packages="$(grep -rLE "^TERMUX_PKG_EXCLUDED_ARCHES=.*${TERMUX_ARCH}" --include=build.sh "${repo}" | cut -d/ -f1,2 | sort || :)"
	fi


	[[ -n "${total_packages}" ]] && no_of_total_packages="$(echo "${total_packages}" | wc -l)"
	[[ -n "${filter_packages}" ]] && no_of_filter_packages="$(echo "${filter_packages}" | wc -l)"
	echo "INFO: Filtered packages: ${no_of_filter_packages} of ${no_of_total_packages}"
	if [[ "${no_of_filter_packages}" == 0 ]]; then
		echo "ERROR: zero packages filtered!" 1>&2
		exit 1
	fi

	random_package_no="$(shuf -i 1-"${no_of_filter_packages}" -n 1)"
	random_package="$(echo "${filter_packages}" | head -n"${random_package_no}" | tail -n1)"
	echo "INFO: Chosen random_package ${random_package_no} = ${random_package}"

	# Packages should not depend on depedencies from more than one external repo
	# Exceptions:
	# veracrypt
	case "${repo}" in
	root-packages) ./scripts/buildorder.py "${random_package}" packages x11-packages ;;
	x11-packages)  ./scripts/buildorder.py "${random_package}" packages ;;
	*)             ./scripts/buildorder.py "${random_package}" ;;
	esac
done
