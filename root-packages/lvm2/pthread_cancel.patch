--- a/lib/blkio/threads.c
+++ b/lib/blkio/threads.c
@@ -24,6 +24,28 @@
 #include <time.h>
 #include <unistd.h>
 
+#ifdef __ANDROID__
+#define PTHREAD_CANCEL_ENABLE 0
+#define PTHREAD_CANCEL_DISABLE 1
+
+static void _thread_signal_handler(int signum)
+{
+	pthread_exit(NULL);
+}
+
+static int _android_setcancelstate(int state, int *oldstate)
+{
+	sigset_t set;
+
+	sigemptyset(&set);
+	sigaddset(&set, SIGUSR2);
+	return pthread_sigmask(state == PTHREAD_CANCEL_ENABLE ? SIG_UNBLOCK : SIG_BLOCK, &set, NULL);
+}
+
+#define pthread_setcancelstate _android_setcancelstate
+#define pthread_cancel(thread) pthread_kill((thread), SIGUSR2)
+#endif
+
