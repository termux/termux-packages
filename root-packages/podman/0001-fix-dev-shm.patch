index a09cc81e2c..066f8f371f 100644
--- a/libpod/lock/shm/shm_lock.h
+++ b/libpod/lock/shm/shm_lock.h
@@ -3,7 +3,64 @@
 
 #include <pthread.h>
 #include <stdint.h>
+#ifdef __ANDROID__
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
 
+#if __ANDROID_API__ < 28
+#ifndef PTHREAD_MUTEX_ROBUST
+#define PTHREAD_MUTEX_ROBUST 1
+#endif
+
+__attribute__((unused))
+static int pthread_mutexattr_setrobust(pthread_mutexattr_t *attr, int robustness) {
+	(void)attr;
+	(void)robustness;
+	return 0;
+}
+
+__attribute__((unused))
+static int pthread_mutex_consistent(pthread_mutex_t *mutex) {
+	(void)mutex;
+	return 0;
+}
+#endif
+
+__attribute__((unused))
+static int android_shm_path(const char *name, char *buf, size_t len) {
+	while (*name == '/') name++;
+	if (*name == '\0' || strchr(name, '/') != NULL) {
+		errno = EINVAL;
+		return -1;
+	}
+	(void)mkdir("@TERMUX_PREFIX@/var/run/shm", 0755);
+	int n = snprintf(buf, len, "@TERMUX_PREFIX@/var/run/shm/%s", name);
+	if (n < 0 || (size_t)n >= len) {
+		errno = ENAMETOOLONG;
+		return -1;
+	}
+	return 0;
+}
+
+__attribute__((unused))
+static int shm_open(const char *name, int oflag, mode_t mode) {
+	char path[PATH_MAX];
+	if (android_shm_path(name, path, sizeof(path)) < 0) return -1;
+	return open(path, oflag | O_NOFOLLOW | O_CLOEXEC, mode);
+}
+
+__attribute__((unused))
+static int shm_unlink(const char *name) {
+	char path[PATH_MAX];
+	if (android_shm_path(name, path, sizeof(path)) < 0) return -1;
+	return unlink(path);
+}
+#endif
 // Magic number to ensure we open the right SHM segment
 #define MAGIC 0x87D1
 
