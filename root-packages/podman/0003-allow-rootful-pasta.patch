@@ -9,14 +9,49 @@
 
 package libpod
 
-import "go.podman.io/common/libnetwork/pasta"
+import (
+	"net"
+	"os"
+	"strings"
+
+	"go.podman.io/common/libnetwork/pasta"
+)
 
 func (r *Runtime) setupPasta(ctr *Container, netns string) error {
+	extraOpts := ctr.config.NetworkOptions[pasta.BinaryName]
+	if os.Geteuid() == 0 {
+		var autoOpts []string
+		hasRunas := false
+		hasOutbound := false
+		for _, opt := range extraOpts {
+			if opt == "--runas" || strings.HasPrefix(opt, "--runas=") {
+				hasRunas = true
+			}
+			if opt == "--outbound-if4" || strings.HasPrefix(opt, "--outbound-if4=") || opt == "-o" {
+				hasOutbound = true
+			}
+		}
+		if !hasRunas {
+			autoOpts = append(autoOpts, "--runas", "0")
+		}
+		if !hasOutbound {
+			for _, ifName := range []string{"tun0", "tun1", "wg0"} {
+				if iface, err := net.InterfaceByName(ifName); err == nil && (iface.Flags&net.FlagUp) != 0 {
+					if addrs, err := iface.Addrs(); err == nil && len(addrs) > 0 {
+						autoOpts = append(autoOpts, "--outbound-if4", ifName)
+						break
+					}
+				}
+			}
+		}
+		extraOpts = append(autoOpts, extraOpts...)
+	}
+
 	res, err := pasta.Setup(&pasta.SetupOptions{
 		Config:       r.config,
 		Netns:        netns,
 		Ports:        ctr.convertPortMappings(),
-		ExtraOptions: ctr.config.NetworkOptions[pasta.BinaryName],
+		ExtraOptions: extraOpts,
 	})
 	if err != nil {
 		return err
