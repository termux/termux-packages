+function resolveParcelWatcherAndroid() {
+  const store = path.resolve(import.meta.dirname, "../../../node_modules/.bun")
+  const [match] = Array.from(
+    new Bun.Glob("@parcel+watcher-android-arm64@*/node_modules/@parcel/watcher-android-arm64/watcher.node").scanSync({
