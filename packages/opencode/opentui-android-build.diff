+
+fn bionicSysrootLib(b: *std.Build, target: std.Build.ResolvedTarget) ?[]const u8 {
+    if (!target.result.abi.isAndroid()) return null;
+    const home = b.graph.environ_map.get("ANDROID_NDK_HOME") orelse return null;
+    const triple: []const u8 = switch (target.result.cpu.arch) {
+        .aarch64 => "aarch64-linux-android",
+        .x86_64 => "x86_64-linux-android",
+        else => return null,
+    };
+    return b.fmt("{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/{s}", .{ home, triple });
