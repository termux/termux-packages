diff --git a/src/contrib/conn_pool.c b/src/contrib/conn_pool.c
index 3832eff..1db5128 100644
--- a/src/contrib/conn_pool.c
+++ b/src/contrib/conn_pool.c
@@ -58,10 +58,26 @@ static conn_pool_fd_t get_old(conn_pool_t *pool,
 	return fd;
 }
 
+#ifdef __ANDROID__
+static void thread_signal_handler(int signum)
+{
+	pthread_exit(0);
+}
+#endif
+
 static void *closing_thread(void *_arg)
 {
 	conn_pool_t *pool = _arg;
 
+#ifdef __ANDROID__
+	struct sigaction actions;
+	memset(&actions, 0, sizeof(actions));
+	sigemptyset(&actions.sa_mask);
+	actions.sa_flags = 0;
+	actions.sa_handler = thread_signal_handler;
+	sigaction(SIGUSR2, &actions, NULL);
+#endif
+
 	while (true) {
 		knot_time_t now = knot_time(), next = 0;
 		knot_timediff_t timeout = conn_pool_timeout(pool, 0);
@@ -127,7 +143,11 @@ void conn_pool_purge(conn_pool_t *pool)
 void conn_pool_deinit(conn_pool_t *pool)
 {
 	if (pool != NULL) {
+#ifndef __ANDROID__
 		pthread_cancel(pool->closing_thread);
+#else
+		pthread_kill(pool->closing_thread, SIGUSR2);
+#endif
 		pthread_join(pool->closing_thread, NULL);
 		conn_pool_purge(pool);
 		pthread_mutex_destroy(&pool->mutex);
diff --git a/src/knot/common/stats.c b/src/knot/common/stats.c
index 0da2184..462d22d 100644
--- a/src/knot/common/stats.c
+++ b/src/knot/common/stats.c
@@ -463,8 +463,24 @@ static void dumper_cleanup(_unused_ void *data)
 	rcu_unregister_thread();
 }
 
+#ifdef __ANDROID__
+static void thread_signal_handler(int signum)
+{
+	pthread_exit(0);
+}
+#endif
+
 static void *dumper(_unused_ void *data)
 {
+#ifdef __ANDROID__
+	struct sigaction actions;
+	memset(&actions, 0, sizeof(actions));
+	sigemptyset(&actions.sa_mask);
+	actions.sa_flags = 0;
+	actions.sa_handler = thread_signal_handler;
+	sigaction(SIGUSR2, &actions, NULL);
+#endif
+
 	rcu_register_thread();
 	pthread_cleanup_push(dumper_cleanup, NULL);
 
@@ -508,7 +524,11 @@ void stats_reconfigure(conf_t *conf, server_t *server)
 		}
 	// Stop current dumping.
 	} else if (stats.active_dumper) {
+#ifndef __ANDROID__
 		pthread_cancel(stats.dumper);
+#else
+		pthread_kill(stats.dumper, SIGUSR2);
+#endif
 		pthread_join(stats.dumper, NULL);
 		stats.active_dumper = false;
 	}
@@ -517,7 +537,11 @@ void stats_reconfigure(conf_t *conf, server_t *server)
 void stats_deinit(void)
 {
 	if (stats.active_dumper) {
+#ifndef __ANDROID__
 		pthread_cancel(stats.dumper);
+#else
+		pthread_kill(stats.dumper, SIGUSR2);
+#endif
 		pthread_join(stats.dumper, NULL);
 	}
 
