+// Base URL of the `solc-bin` branch of the `togashigreat/termux-solidity`
+// repository, which publishes Solc binaries compiled for every Termux-supported
+// Android ABI. `<base>/android/<abi>/list.json` lists the releases and
+// `<base>/android/<abi>/<artifact>` serves each binary.
+const TERMUX_SOLC_RELEASES_URL: &str =
+    "https://raw.githubusercontent.com/togashigreat/termux-solidity/solc-bin";
+
+/// Returns the URL prefix for the given platform on the termux-solidity
+/// `solc-bin` branch (e.g. `.../android/x86`), or `None` for non-Android
+/// platforms which keep using the official binary releases.
+fn termux_solc_url_prefix(platform: Platform) -> Option<String> {
+    platform
+        .android_abi()
+        .map(|abi| format!("{TERMUX_SOLC_RELEASES_URL}/android/{abi}"))
+}
 
