+/// Returns the directory in which the Termux `foundry` package installs the Solidity compilers it
+/// bundles with the package: `<prefix>/libexec/foundry/svm`.
+///
+/// The prefix is derived from the location of the running executable (`<prefix>/bin/forge`)
+/// instead of being hardcoded, so the same binary works no matter where the prefix lives.
+fn packaged_data_dir() -> Option<PathBuf> {
+    // .../bin/<binary> -> .../<prefix>
+    let prefix = std::env::current_exe().ok()?.parent()?.parent()?.to_path_buf();
+    Some(prefix.join("libexec").join("foundry").join("svm"))
+}
