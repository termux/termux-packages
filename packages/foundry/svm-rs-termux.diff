+/// Returns the path of the Solidity compiler bundled with the Termux package for `version`.
+///
+/// Termux ships a fixed set of compilers under `<prefix>/libexec/foundry/svm`, which is what
+/// [`data_dir`] resolves to there. Nothing is ever downloaded: the prebuilt binaries published
+/// upstream are glibc/musl ELFs that cannot be executed on Android, so the compilers bundled with
+/// the package are the only ones available. A version that is not bundled fails with the error
+/// upstream itself uses for a version that has no artifact for the current platform.
+#[cfg(target_os = "android")]
+fn bundled_solc(version: &Version) -> Result<PathBuf, SvmError> {
+    let path = version_binary(&version.to_string());
+    if path.is_file() {
+        Ok(path)
+    } else {
+        Err(SvmError::UnknownVersion(version.clone()))
+    }
+}
