Use libc fstatat() instead of the statx syscall on Linux. Android seccomp kills
the process (SIGSYS) on releases that do not allow statx. The NO_AUTOMOUNT flag
keeps musl from using the stat syscall for AT_FDCWD, which is blocked on x86_64.
struct stat is not available from Zig's std or translate-c here, so a small C
shim (stat_shim.c, copied into src/ by build.sh) reads it.

--- a/build.zig
+++ b/build.zig
@@ -76,6 +76,7 @@ pub fn build(b: *std.Build) void {
     }
 
     main_mod.addImport("c", t.mod);
+    if (target.result.os.tag == .linux) main_mod.addCSourceFile(.{ .file = b.path("src/stat_shim.c") });
 
     const build_options = b.addOptions();
     build_options.addOption([:0]const u8, "version", manifest.version);
--- a/src/scan.zig
+++ b/src/scan.zig
