# What Docker needs from the kernel, and why each group is here.
#
# The list is taken from moby's own contrib/check-config.sh, which is what
# `docker info` effectively complains about at runtime. Groups below are in the
# order that script checks them, so a failure there maps straight back to here.
#
# Nothing in this file is UML-specific: containers are namespaces, cgroups, a
# union filesystem and netfilter, all of which are generic kernel features. The
# one UML-specific prerequisite lives in config/usb-wifi.config's neighbours --
# see arch/um/Kconfig -- and is not needed for containers.

# --- namespaces: what actually isolates a container ---
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
# USER_NS is what rootless docker and userns-remap need. It is also the one
# Android denies to apps -- that restriction is on the host, not in here, and
# the guest is free to have it.
CONFIG_USER_NS=y

# --- cgroups: what limits a container ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
# CPUSETS is deliberately absent: it depends on SMP and UML is uniprocessor.
# docker info reports "WARNING: No cpuset support" and runs; there is nothing to
# pin to on one CPU anyway.
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y

# --- keyring: containerd and runc both use it ---
CONFIG_KEYS=y

# --- storage driver ---
# Without overlayfs docker falls back to the vfs driver, which copies the whole
# image on every layer instead of stacking it -- correct, and slow enough to
# look broken.
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# --- container networking: veth pair into a bridge, masqueraded out ---
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
# XT_MATCH_IPVS needs IP_VS, which is swarm-mode load balancing -- not wanted
# here, and check-config.sh lists it as optional.
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NF_TABLES=y
# Debian 12's iptables is iptables-nft, so nf_tables above is what actually
# carries docker's rules. The legacy xtables path is kept because check-config.sh
# still tests for it and because some images ship iptables-legacy binaries; in
# this tree the classic IP_NF_* symbols moved behind *_LEGACY gates, and without
# these two they silently vanish from the config.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# --- seccomp: runc's default profile ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- posix message queues: checked by check-config.sh ---
CONFIG_POSIX_MQUEUE=y

# --- let the guest answer the question itself ---
# check-config.sh reads /proc/config.gz when it cannot find a config file, so
# with these the guest can verify its own kernel rather than trusting a claim
# made on the build host about a binary it may not even be running.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- the rest of what check-config.sh calls Generally Necessary ---
# IPv6 netfilter: docker sets up ip6tables rules for every network unless
# explicitly told not to, and refuses ipv6 networks without them.
# The v6 tables need the v6 stack; the UML defconfig does not enable it.
CONFIG_IPV6=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_MANGLE=y
# CGROUP_BPF is how docker applies per-container device rules on cgroup v2 --
# the old devices cgroup does not exist there, so without this the device
# controller silently does nothing.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# --- optional, but cheap and things ask for them ---
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y

# --- nftables backend, which is what Debian's iptables actually is ---
# bookworm ships iptables-nft: /usr/sbin/iptables reports "v1.8.9 (nf_tables)"
# and speaks to nf_tables, not to the legacy xtables above. With only
# CONFIG_NF_TABLES set there is no address-family backend for it to create a
# table in, and dockerd dies during network setup with
#   iptables --wait -t nat -N DOCKER: TABLE_ADD failed (Operation not
#   supported): table nat
# which names neither nftables nor a missing option, so it reads like a
# permissions problem rather than a kernel one.
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_INET=y
# iptables-nft expresses a few matches (addrtype, conntrack state) by embedding
# the classic xt modules inside nftables rules; without this they fail one rule
# at a time rather than at table creation.
CONFIG_NFT_COMPAT=y
