@@ -0,0 +1,16 @@
+# Docker on the bionic build, minus BPF.
+#
+# CONFIG_BPF_SYSCALL does not compile against bionic here, and the reason is
+# this port's own doing rather than anything in BPF: arch/arm64/Makefile.um
+# renames a handful of libc names with -D so that bionic's own calls do not
+# bind to the kernel's definitions, and "snprintf" is not only a function name
+# but a bare token in __BPF_FUNC_MAPPER. The rename rewrites it there too, so
+# kernel/bpf/disasm.c asks for BPF_FUNC_kernel_snprintf, which does not exist.
+#
+# The real fix is to rename at the object level (objcopy --redefine-sym) rather
+# than in the preprocessor, where it cannot touch identifiers being assembled by
+# token pasting. Until then this file is docker.config without CGROUP_BPF, which
+# costs the device controller on cgroup v2 -- docker starts and runs; per
+# container device rules are not enforced.
+CONFIG_BPF_SYSCALL=n
+CONFIG_CGROUP_BPF=n
diff --git a/tools/um-arm64/config/docker.config b/tools/um-arm64/config/docker.config
new file mode 100644
index 0000000000000..0ff651856e363
--- /dev/null
+++ b/tools/um-arm64/config/docker.config
@@ -0,0 +1,142 @@
+# What Docker needs from the kernel, and why each group is here.
+#
+# The list is taken from moby's own contrib/check-config.sh, which is what
+# `docker info` effectively complains about at runtime. Groups below are in the
+# order that script checks them, so a failure there maps straight back to here.
+#
+# Nothing in this file is UML-specific: containers are namespaces, cgroups, a
+# union filesystem and netfilter, all of which are generic kernel features. The
+# one UML-specific prerequisite lives in config/usb-wifi.config's neighbours --
+# see arch/um/Kconfig -- and is not needed for containers.
+
+# --- namespaces: what actually isolates a container ---
+CONFIG_NAMESPACES=y
+CONFIG_NET_NS=y
+CONFIG_PID_NS=y
+CONFIG_IPC_NS=y
+CONFIG_UTS_NS=y
+# USER_NS is what rootless docker and userns-remap need. It is also the one
+# Android denies to apps -- that restriction is on the host, not in here, and
+# the guest is free to have it.
+CONFIG_USER_NS=y
+
+# --- cgroups: what limits a container ---
+CONFIG_CGROUPS=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_CPUACCT=y
+# CPUSETS is deliberately absent: it depends on SMP and UML is uniprocessor.
+# docker info reports "WARNING: No cpuset support" and runs; there is nothing to
+# pin to on one CPU anyway.
+CONFIG_MEMCG=y
+CONFIG_BLK_CGROUP=y
+CONFIG_FAIR_GROUP_SCHED=y
+CONFIG_CFS_BANDWIDTH=y
+
+# --- keyring: containerd and runc both use it ---
+CONFIG_KEYS=y
+
+# --- storage driver ---
+# Without overlayfs docker falls back to the vfs driver, which copies the whole
+# image on every layer instead of stacking it -- correct, and slow enough to
+# look broken.
+CONFIG_OVERLAY_FS=y
+CONFIG_EXT4_FS_POSIX_ACL=y
+CONFIG_EXT4_FS_SECURITY=y
+
+# --- container networking: veth pair into a bridge, masqueraded out ---
+CONFIG_VETH=y
+CONFIG_BRIDGE=y
+CONFIG_BRIDGE_NETFILTER=y
+CONFIG_NETFILTER=y
+CONFIG_NETFILTER_ADVANCED=y
+CONFIG_NF_CONNTRACK=y
+CONFIG_NF_NAT=y
+CONFIG_NETFILTER_XTABLES=y
+CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
+CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
+# XT_MATCH_IPVS needs IP_VS, which is swarm-mode load balancing -- not wanted
+# here, and check-config.sh lists it as optional.
+CONFIG_NETFILTER_XT_MARK=y
+CONFIG_NF_TABLES=y
+# Debian 12's iptables is iptables-nft, so nf_tables above is what actually
+# carries docker's rules. The legacy xtables path is kept because check-config.sh
+# still tests for it and because some images ship iptables-legacy binaries; in
+# this tree the classic IP_NF_* symbols moved behind *_LEGACY gates, and without
+# these two they silently vanish from the config.
+CONFIG_NETFILTER_XTABLES_LEGACY=y
+CONFIG_IP_NF_IPTABLES_LEGACY=y
+CONFIG_IP_NF_IPTABLES=y
+CONFIG_IP_NF_FILTER=y
+CONFIG_IP_NF_NAT=y
+CONFIG_IP_NF_TARGET_MASQUERADE=y
+
+# --- seccomp: runc's default profile ---
+CONFIG_SECCOMP=y
+CONFIG_SECCOMP_FILTER=y
+
+# --- posix message queues: checked by check-config.sh ---
+CONFIG_POSIX_MQUEUE=y
+
+# --- let the guest answer the question itself ---
+# check-config.sh reads /proc/config.gz when it cannot find a config file, so
+# with these the guest can verify its own kernel rather than trusting a claim
+# made on the build host about a binary it may not even be running.
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+
+# --- the rest of what check-config.sh calls Generally Necessary ---
+# IPv6 netfilter: docker sets up ip6tables rules for every network unless
+# explicitly told not to, and refuses ipv6 networks without them.
+# The v6 tables need the v6 stack; the UML defconfig does not enable it.
+CONFIG_IPV6=y
+CONFIG_IP6_NF_IPTABLES_LEGACY=y
+CONFIG_IP6_NF_IPTABLES=y
+CONFIG_IP6_NF_FILTER=y
+CONFIG_IP6_NF_MANGLE=y
+CONFIG_IP6_NF_RAW=y
+CONFIG_IP6_NF_NAT=y
+CONFIG_IP6_NF_TARGET_MASQUERADE=y
+CONFIG_IP_NF_RAW=y
+CONFIG_IP_NF_MANGLE=y
+# CGROUP_BPF is how docker applies per-container device rules on cgroup v2 --
+# the old devices cgroup does not exist there, so without this the device
+# controller silently does nothing.
+CONFIG_BPF=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_CGROUP_BPF=y
+
+# --- optional, but cheap and things ask for them ---
+CONFIG_BLK_DEV_THROTTLING=y
+CONFIG_NET_CLS_CGROUP=y
+CONFIG_CGROUP_NET_PRIO=y
+
+# --- nftables backend, which is what Debian's iptables actually is ---
+# bookworm ships iptables-nft: /usr/sbin/iptables reports "v1.8.9 (nf_tables)"
+# and speaks to nf_tables, not to the legacy xtables above. With only
+# CONFIG_NF_TABLES set there is no address-family backend for it to create a
+# table in, and dockerd dies during network setup with
+#   iptables --wait -t nat -N DOCKER: TABLE_ADD failed (Operation not
+#   supported): table nat
+# which names neither nftables nor a missing option, so it reads like a
+# permissions problem rather than a kernel one.
+CONFIG_NF_TABLES_IPV4=y
+CONFIG_NF_TABLES_IPV6=y
+CONFIG_NF_TABLES_INET=y
+CONFIG_NFT_NAT=y
+CONFIG_NFT_MASQ=y
+CONFIG_NFT_REDIR=y
+CONFIG_NFT_CT=y
+CONFIG_NFT_LIMIT=y
+CONFIG_NFT_LOG=y
+CONFIG_NFT_REJECT=y
+CONFIG_NFT_REJECT_INET=y
+CONFIG_NFT_FIB=y
+CONFIG_NFT_FIB_IPV4=y
+CONFIG_NFT_FIB_INET=y
+# iptables-nft expresses a few matches (addrtype, conntrack state) by embedding
+# the classic xt modules inside nftables rules; without this they fail one rule
+# at a time rather than at table creation.
+CONFIG_NFT_COMPAT=y
diff --git a/tools/um-arm64/config/usb-wifi.config b/tools/um-arm64/config/usb-wifi.config
new file mode 100644
index 0000000000000..130bc48d41ce0
--- /dev/null
+++ b/tools/um-arm64/config/usb-wifi.config
@@ -0,0 +1,67 @@
+# Kernel symbols for passing a USB WiFi adapter into the guest.
+#
+# Apply on top of the ordinary defconfig, out of tree:
+#
+#	make -C linux O=$O ARCH=um SUBARCH=arm64 LLVM=1 defconfig
+#	cat config/usb-wifi.config >> $O/.config
+#	make -C linux O=$O ARCH=um SUBARCH=arm64 LLVM=1 olddefconfig
+#
+# The thirteen lines below become 92 new symbols after olddefconfig -- crypto
+# for mac80211, the RTW88_CORE/88XXA/8821A chain, USB_COMMON, SGL_ALLOC and so
+# on all arrive by select or by default, so none of them is repeated here. The
+# only symbols that go *away* are NO_IOMEM and NO_DMA, which is the point of
+# the first group.
+#
+# Everything is =y because this kernel has no module support (CONFIG_MODULES is
+# not set in the UML defconfig, and the guest image has no modutils): a driver
+# that is not built in does not exist.
+
+# usbcore depends on HAS_IOMEM and HAS_DMA, and that is the whole reason these
+# two are here -- vhci-hcd itself contains neither MMIO nor DMA; its "bus" is a
+# socket. Before 7a70d4a6f both emulations were hidden symbols that only
+# UML_PCI selected, so reaching usbcore meant enabling a PCI bus that then warns
+# at boot with "No virtio device ID configured for PCI - no PCI support" and a
+# stack trace. Selecting UML_IOMEM_EMULATION also clears NO_IOMEM, which depends
+# on !INDIRECT_IOMEM.
+CONFIG_UML_IOMEM_EMULATION=y
+CONFIG_UML_DMA_EMULATION=y
+
+# The USB stack and the virtual host controller the adapter arrives through.
+# vhci-hcd takes a SOCK_STREAM socket written into
+# /sys/devices/platform/vhci_hcd.0/attach and presents whatever is on the other
+# end as a device on its root hub; the other end here is umusb on the Android
+# side, driving the real adapter through the usbfs descriptor the permission
+# dialog handed the app.
+#
+# USBIP_HOST -- the export direction -- is deliberately not enabled: the guest
+# has no real USB device of its own to share, and vhci-hcd is the only half of
+# USB/IP this design uses.
+CONFIG_USB_SUPPORT=y
+CONFIG_USB=y
+CONFIG_USBIP_CORE=y
+CONFIG_USBIP_VHCI_HCD=y
+
+# The wireless stack, and the driver for the adapter in hand: a Realtek
+# RTL8811AU (USB 2357:011f). rtw88's 8821au front end covers both parts -- its
+# Kconfig prompt says "8821AU/8811AU" and 2357:011f is in rtw_8821au_id_table --
+# and they share rtw8821a_hw_spec. The interface descriptor is
+# class/subclass/protocol 0xff, so the match is by USB_DEVICE_AND_INTERFACE_INFO
+# and nothing generic will bind it by accident.
+#
+# RTW88_USB, RTW88_CORE, RTW88_8821A and RTW88_88XXA are all reached by select
+# from RTW88_8821AU. WLAN and WLAN_VENDOR_REALTEK are already y in defconfig and
+# are listed only so this fragment stands on its own.
+CONFIG_CFG80211=y
+CONFIG_MAC80211=y
+CONFIG_WLAN=y
+CONFIG_WLAN_VENDOR_REALTEK=y
+CONFIG_RTW88=y
+CONFIG_RTW88_USB=y
+CONFIG_RTW88_8821AU=y
+
+# Not enabled here, but the first two things to turn on when an attach
+# misbehaves: USBIP_DEBUG, which makes vhci log every URB, and RTW88_DEBUG,
+# which turns on rtw_dbg() so the firmware handshake is visible. Both are pure
+# noise once the link works, which is why they are left off. (Written without a
+# leading "CONFIG_" on purpose: merge_config.sh reads any commented line
+# beginning with that prefix as a symbol assignment.)
diff --git a/tools/um-arm64/dist/umapp/AndroidManifest.xml b/tools/um-arm64/dist/umapp/AndroidManifest.xml
new file mode 100644
index 0000000000000..fb7729a6b708d
--- /dev/null
+++ b/tools/um-arm64/dist/umapp/AndroidManifest.xml
@@ -0,0 +1,86 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  umarm - a Linux kernel running inside an ordinary Android app.
+
+  The point of packaging it as an app rather than an adb shell script is that
+  the app sandbox is much narrower than the shell's: an app runs in the
+  untrusted_app SELinux domain, under a W^X policy that forbids executing
+  anything the app wrote itself. The only directory an app may execute from is
+  the native library directory unpacked from its own APK, which is why the
+  kernel, the stub, passt, umnet and umusb are all shipped as lib*.so.
+
+  android:extractNativeLibs="true" matters for the same reason: the binaries
+  have to exist as real files on disk to be exec'd, not mapped straight out of
+  a compressed APK.
+-->
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="org.umarm.debian"
+    android:versionCode="1"
+    android:versionName="0.1">
+
+    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
+
+    <!--
+      Without this the guest has no network and the reason is well hidden.
+      Android gates socket(2) on group membership rather than on a check at
+      connect time: the INTERNET permission is what puts the app's uid in the
+      "inet" group, and without it every socket() an app makes returns EPERM.
+      passt, which is what gives the guest its network, then comes up, prints
+      its DHCP and DNS configuration exactly as if it had worked, and only then
+      fails with "Error refilling IPv4 host socket pool: Operation not
+      permitted". The guest boots, gets a lease, and can reach nothing.
+    -->
+    <uses-permission android:name="android.permission.INTERNET" />
+
+    <!--
+      USB host mode, for handing a Realtek RTL8811AU through to the guest.
+
+      required="false" on purpose: this is the app's optional trick, not its
+      reason to exist. Declared required, the platform would refuse to install
+      it on any device without USB host support, and most runs here have
+      nothing plugged in at all.
+
+      There is no permission to declare alongside it. Access to a USB device
+      is granted per device, at runtime, by the user, and the descriptor comes
+      back through UsbDeviceConnection; an app never opens /dev/bus/usb.
+    -->
+    <uses-feature android:name="android.hardware.usb.host"
+        android:required="false" />
+
+    <application
+        android:label="umarm"
+        android:extractNativeLibs="true"
+        android:allowBackup="false"
+        android:debuggable="true">
+
+        <activity
+            android:name=".MainActivity"
+            android:exported="true"
+            android:label="umarm"
+            android:launchMode="singleTop"
+            android:configChanges="orientation|screenSize|keyboardHidden">
+            <intent-filter>
+                <action android:name="android.intent.action.MAIN" />
+                <category android:name="android.intent.category.LAUNCHER" />
+            </intent-filter>
+
+            <!--
+              Plugging the adapter in offers to launch umarm, and the platform
+              then grants permission to that device with no dialog. Worth
+              having: the alternative is a dialog that has to be answered
+              before the guest can start.
+
+              singleTop above belongs to this. Without it, attaching the
+              adapter while a guest is running would stack a second Activity
+              on top of the boot in progress instead of delivering the intent
+              to the one already there.
+            -->
+            <intent-filter>
+                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
+            </intent-filter>
+            <meta-data
+                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
+                android:resource="@xml/device_filter" />
+        </activity>
+    </application>
+</manifest>
diff --git a/tools/um-arm64/dist/umapp/build-apk.sh b/tools/um-arm64/dist/umapp/build-apk.sh
new file mode 100755
index 0000000000000..b9c2100ff1bf9
--- /dev/null
+++ b/tools/um-arm64/dist/umapp/build-apk.sh
@@ -0,0 +1,155 @@
+#!/bin/bash
+# Build the umarm APK without Gradle.
+#
+# Gradle would drag in a whole Android project layout and a network fetch of its
+# own toolchain; this needs four tools and about ten seconds. The pieces:
+#
+#   aapt2 / aapt  package resources and the manifest into a partial APK
+#   javac         compile the one Activity against android.jar
+#   d8            translate the .class files into classes.dex
+#   apksigner     sign it (Android refuses to install an unsigned APK)
+#
+# The native binaries are the interesting part. An Android app runs in the
+# untrusted_app SELinux domain, which forbids executing anything the app itself
+# wrote -- so the kernel, the stub, passt and umnet cannot simply be unpacked
+# into the app's data directory and run. The one exception is the native library
+# directory the platform unpacks from the APK, so each binary is shipped as a
+# lib*.so under lib/arm64-v8a/ and executed from getApplicationInfo()
+# .nativeLibraryDir. They are ordinary executables, not shared libraries; the
+# name is what matters, not the format.
+# -e as well as -uo pipefail. Without it a failing aapt2 or d8 left the previous
+# umarm.apk sitting on disk, the script carried on to "signing" and printed the
+# usual "install with: ..." line, and `adb install` then reported Success --
+# for the build before the change being tested. A broken manifest looked
+# exactly like a working one until the behaviour on the device made no sense.
+set -euo pipefail
+
+HERE=$(cd "$(dirname "$0")" && pwd)
+ROOT=${ROOT:-/root/mlu-arm64}
+# Newest first. r34's d8 throws an internal NullPointerException on classes
+# compiled by JDK 21 ("Cannot invoke String.length() because <parameter1> is
+# null"), which reads like a bug in the app source and is not one -- r35's d8
+# takes the identical .class files. Picking the lowest version found made that
+# failure depend on which build-tools happened to be unpacked.
+BT=${BT:-$(ls -d /tmp/bt*/android-* 2>/dev/null | sort -V | tail -1)}
+ANDROID_JAR=${ANDROID_JAR:-$(find /tmp/plat -name android.jar 2>/dev/null | head -1)}
+OUT=${OUT:-$HERE/build}
+APK=${APK:-$HERE/umarm.apk}
+
+# What goes in as a "native library". Each entry is src:libname.
+BINARIES=(
+	"$ROOT/artifacts/linux-bionic:libuml.so"
+	"$ROOT/artifacts/stub_exe_bionic:libstub.so"
+	# A scratch slot for probes: whatever is here can be exec'd in the app's
+	# own uid and SELinux domain via `run-as`, which /data/local/tmp cannot be.
+	"$ROOT/artifacts/sockprobe_bionic:libprobe.so"
+	"$ROOT/dist/umdebian/umnet:libumnet.so"
+	"$ROOT/dist/umdebian/passt:libpasst.so"
+	"$ROOT/dist/umdebian/appseccomp:libappseccomp.so"
+	# The USB/IP server side of the passthrough. Absent until it is built,
+	# and the app says so rather than failing obscurely: with "usb" ticked
+	# and no libumusb.so it prints "not in this build" and boots without it.
+	"$ROOT/dist/umdebian/umusb:libumusb.so"
+)
+INITRAMFS=${INITRAMFS:-$ROOT/rootfs/initramfs-alpine.cpio.gz}
+rm -f "$(dirname "$0")/umarm.apk"
+
+ROOTFS_GZ=${ROOTFS_GZ:-}		# optional: a gzipped ext4 to ship as the root disk
+
+for t in "$BT/aapt2" "$BT/d8" "$BT/apksigner"; do
+	[ -x "$t" ] || { echo "build-apk: missing $t" >&2; exit 2; }
+done
+[ -f "$ANDROID_JAR" ] || { echo "build-apk: no android.jar (set ANDROID_JAR)" >&2; exit 2; }
+command -v javac >/dev/null || { echo "build-apk: no javac" >&2; exit 2; }
+
+rm -rf "$OUT"
+mkdir -p "$OUT/res" "$OUT/classes" "$OUT/lib/arm64-v8a" "$OUT/assets"
+
+# aapt2 compiles a directory tree, and $OUT is wiped on every build, so the
+# checked-in resources have to be copied into it. res/xml/device_filter.xml is
+# what the manifest's @xml/device_filter points at; without this copy aapt2
+# link fails on an unresolved reference rather than producing an APK that is
+# merely missing the USB attach filter.
+if [ -d "$HERE/res" ]; then
+	cp -a "$HERE/res/." "$OUT/res/"
+fi
+
+echo "== staging native binaries =="
+for b in "${BINARIES[@]}"; do
+	src=${b%%:*}; dst=${b##*:}
+	if [ -f "$src" ]; then
+		cp -f "$src" "$OUT/lib/arm64-v8a/$dst"
+		printf '   %-14s %s\n' "$dst" "$(du -h "$src" | cut -f1)"
+	else
+		echo "   WARNING: $src missing, $dst will be absent"
+	fi
+done
+
+echo "== staging assets =="
+cp -f "$INITRAMFS" "$OUT/assets/initramfs.cpio.gz"
+printf '   %-14s %s\n' "initramfs" "$(du -h "$INITRAMFS" | cut -f1)"
+if [ -n "$ROOTFS_GZ" ] && [ -f "$ROOTFS_GZ" ]; then
+	cp -f "$ROOTFS_GZ" "$OUT/assets/rootfs.ext4.gz"
+	printf '   %-14s %s\n' "rootfs" "$(du -h "$ROOTFS_GZ" | cut -f1)"
+fi
+
+echo "== compiling =="
+"$BT/aapt2" compile --dir "$OUT/res" -o "$OUT/res.zip" 2>/dev/null
+
+# Each of these checks its own status rather than being filtered through a
+# pipeline. `cmd | grep -v ... | head` cannot report failure under pipefail --
+# and worse, grep -v exits 1 when it filters everything away, so a *clean*
+# javac aborted the script once set -e was added.
+if ! "$BT/aapt2" link \
+	-o "$OUT/base.apk" \
+	-I "$ANDROID_JAR" \
+	--manifest "$HERE/AndroidManifest.xml" \
+	--java "$OUT/classes" \
+	${ROOTFS_GZ:+} \
+	"$OUT/res.zip" > "$OUT/aapt2.log" 2>&1; then
+	echo "aapt2 link failed:" >&2
+	head -20 "$OUT/aapt2.log" >&2
+	exit 2
+fi
+
+if ! javac -source 8 -target 8 -nowarn \
+	-bootclasspath "$ANDROID_JAR" \
+	-classpath "$ANDROID_JAR" \
+	-d "$OUT/classes" \
+	$(find "$HERE/src" "$OUT/classes" -name '*.java') > "$OUT/javac.log" 2>&1; then
+	echo "javac failed:" >&2
+	grep -v "^Note:" "$OUT/javac.log" | head -20 >&2
+	exit 2
+fi
+
+# --lib is not optional: without the framework on d8's classpath it fails with
+# an internal NullPointerException on the first nested anonymous class, which
+# looks like a compiler bug rather than a missing argument.
+"$BT/d8" --min-api 26 --lib "$ANDROID_JAR" --output "$OUT" \
+	$(find "$OUT/classes" -name '*.class') 2>&1 | head -5 || exit 2
+
+echo "== packaging =="
+# aapt2 link produced base.apk with resources and the manifest; add dex, libs
+# and assets to it. Native libraries are stored uncompressed so the platform
+# can extract them; assets are compressed because they are just data.
+cd "$OUT"
+cp base.apk staged.apk
+zip -q -0 staged.apk classes.dex
+zip -q -0 -r staged.apk lib
+zip -q -9 -r staged.apk assets
+
+echo "== signing =="
+KS="$HERE/debug.keystore"
+if [ ! -f "$KS" ]; then
+	keytool -genkeypair -keystore "$KS" -storepass umarmumarm -keypass umarmumarm \
+		-alias umarm -keyalg RSA -keysize 2048 -validity 10000 \
+		-dname "CN=umarm, OU=dev, O=umarm, L=x, S=x, C=xx" >/dev/null 2>&1
+fi
+
+"$BT/zipalign" -f -p 4 staged.apk aligned.apk >/dev/null 2>&1 || cp staged.apk aligned.apk
+"$BT/apksigner" sign --ks "$KS" --ks-pass pass:umarmumarm --key-pass pass:umarmumarm \
+	--min-sdk-version 26 --out "$APK" aligned.apk || exit 2
+
+echo
+echo "APK: $APK  ($(du -h "$APK" | cut -f1))"
+echo "install with:  adb install -r -t $APK"
diff --git a/tools/um-arm64/dist/umapp/src/org/umarm/debian/MainActivity.java b/tools/um-arm64/dist/umapp/src/org/umarm/debian/MainActivity.java
new file mode 100644
index 0000000000000..9d646fd18fdc6
--- /dev/null
+++ b/tools/um-arm64/dist/umapp/src/org/umarm/debian/MainActivity.java
@@ -0,0 +1,796 @@
+package org.umarm.debian;
+
+import android.app.Activity;
+import android.app.PendingIntent;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.hardware.usb.UsbDevice;
+import android.hardware.usb.UsbDeviceConnection;
+import android.hardware.usb.UsbManager;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.ParcelFileDescriptor;
+import android.system.Os;
+import android.system.OsConstants;
+import android.text.InputType;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup.LayoutParams;
+import android.view.inputmethod.EditorInfo;
+import android.widget.Button;
+import android.widget.CheckBox;
+import android.widget.EditText;
+import android.widget.HorizontalScrollView;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+
+import android.net.LocalServerSocket;
+import android.net.LocalSocket;
+import java.io.FileDescriptor;
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.zip.GZIPInputStream;
+
+/**
+ * A Linux kernel, running inside an ordinary Android app.
+ *
+ * This exists to move the port out of the adb shell and into the app sandbox,
+ * which is a materially harder environment and the one that actually matters
+ * for shipping. The differences that shape this class:
+ *
+ *   - An app runs in the untrusted_app SELinux domain under a W^X policy. It
+ *     may not execute anything it wrote itself, so every binary -- the kernel,
+ *     the stub, passt, umnet, umusb -- ships as a lib*.so inside the APK and
+ *     is run from getApplicationInfo().nativeLibraryDir, the one directory an
+ *     app is allowed to execute from.
+ *   - UML normally execs its stub from an anonymous memfd. That is refused
+ *     here, so the kernel is passed stub_exe=<nativeLibraryDir>/libstub.so.
+ *   - There is no /tmp. Guest RAM is backed from the app's cache directory.
+ *
+ * The UI is deliberately plain: a scrolling log, a line-input box wired to the
+ * guest's stdin, and the few settings worth changing while debugging. It is a
+ * console, not a terminal emulator -- there is no ANSI or cursor handling,
+ * because the point is to see what the kernel says, not to run vim.
+ */
+public class MainActivity extends Activity {
+
+    private TextView log;
+    private ScrollView scroll;
+    private EditText input;
+    private EditText memField;
+    private CheckBox seccompBox;
+    private CheckBox netBox;
+    private CheckBox usbBox;
+    private Button startStop;
+
+    private Process guest;
+    private OutputStream guestIn;
+    private final Handler ui = new Handler(Looper.getMainLooper());
+
+    private static final int MAX_CHARS = 200000;
+
+    @Override
+    protected void onCreate(Bundle saved) {
+        super.onCreate(saved);
+
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(12, 12, 12, 12);
+
+        /* --- settings row --- */
+        LinearLayout settings = new LinearLayout(this);
+        settings.setOrientation(LinearLayout.HORIZONTAL);
+        settings.setGravity(Gravity.CENTER_VERTICAL);
+
+        TextView memLabel = new TextView(this);
+        memLabel.setText("RAM MB ");
+        settings.addView(memLabel);
