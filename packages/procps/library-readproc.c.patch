diff -uNr procps-ng-4.0.7/library/readproc.c procps-ng-4.0.7.mod/library/readproc.c
--- procps-ng-4.0.7/library/readproc.c	2026-07-07 08:30:50.000000000 +0000
+++ procps-ng-4.0.7.mod/library/readproc.c	2026-09-19 13:14:57.235565496 +0000
@@ -1301,6 +1301,21 @@
     if(p->nlwp > 1)
       p->wchan = ~0ul;
 
+    // Termux patch to use argv0 instead of executable name,
+    // since that will soon (at time of writing) always be
+    // /system/bin/linker64.
+    char** cmdline_vec = file2strvec(PT->pidfd, "cmdline");
+    if (cmdline_vec) {
+        if (cmdline_vec[0] && *cmdline_vec[0]) {
+            char *argv0 = strdup(cmdline_vec[0]);
+            if (argv0) {
+                free(p->cmd);
+                p->cmd = argv0;
+            }
+        }
+        free(*cmdline_vec);
+    }
+
     /* some number->text resolving which is time consuming */
     /* ( names are cached, so memcpy to arrays was silly ) */
     if (flags & PROC_FILLUSR)
