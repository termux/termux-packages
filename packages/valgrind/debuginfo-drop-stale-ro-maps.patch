+/* Forget read-only mappings of |di| which are no longer mapped from its
+   file.  The Android linker maps and unmaps ELF fragments transiently,
+   and stale entries make the overlap check discard unrelated debuginfo. */
+static void drop_stale_ro_mappings ( DebugInfo* di )
+{
+   Word i = 0;
+   while (i < VG_(sizeXA)(di->fsm.maps)) {
+      const DebugInfoMapping* map = VG_(indexXA)(di->fsm.maps, i);
+      Bool stale = False;
+      if (map->ro && !map->rx && !map->rw) {
+         const NSegment* seg = VG_(am_find_nsegment)(map->avma);
+         const HChar* segname = seg ? VG_(am_get_filename)(seg) : NULL;
+         stale = seg == NULL
+                 || (seg->kind != SkFileC && seg->kind != SkFileV)
+                 || seg->start > map->avma
+                 || seg->end + 1 < map->avma + map->size
+                 || segname == NULL
+                 || VG_(strcmp)(segname, di->fsm.filename) != 0;
+      }
+      if (stale)
+         VG_(removeIndexXA)(di->fsm.maps, i);
+      else
+         i++;
+   }
+}
+
+
+/* Forget read-only mappings lying within the just unmapped range. */
+static void drop_ro_mappings_in_range ( Addr start, SizeT length )
+{
+   DebugInfo* di;
+   for (di = debugInfo_list; di; di = di->next) {
+      Word i = 0;
+      if (is_DebugInfo_archived(di))
+         continue;
+      while (i < VG_(sizeXA)(di->fsm.maps)) {
+         const DebugInfoMapping* map = VG_(indexXA)(di->fsm.maps, i);
+         if (map->ro && !map->rx && !map->rw
+             && map->avma >= start
+             && map->avma + map->size <= start + length)
+            VG_(removeIndexXA)(di->fsm.maps, i);
+         else
+            i++;
+      }
+   }
+}
