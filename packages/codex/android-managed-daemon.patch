+/// Validate the official Termux package layout selected by this process.
+#[cfg(any(target_os = "android", all(test, unix)))]
+pub(crate) fn ensure_android_package(selected: &Path) -> Result<()> {
+    use std::os::unix::fs::PermissionsExt;
+
+    let selected = selected
+        .canonicalize()
+        .context("missing selected Android executable")?;
+    anyhow::ensure!(
+        selected.file_name().is_some_and(|name| name == "codex")
+            && selected
+                .parent()
+                .and_then(Path::file_name)
+                .is_some_and(|name| name == "bin"),
+        "selected Android executable is not bin/codex"
+    );
+    let selected_metadata =
+        std::fs::metadata(&selected).context("failed to inspect selected Android executable")?;
+    anyhow::ensure!(
+        selected_metadata.is_file() && selected_metadata.permissions().mode() & 0o111 != 0,
+        "selected Android codex executable is not an executable regular file"
+    );
+    let helper = selected.with_file_name("codex-code-mode-host");
+    let helper_metadata =
+        std::fs::metadata(&helper).context("Termux package is missing codex-code-mode-host")?;
+    anyhow::ensure!(
+        helper_metadata.is_file() && helper_metadata.permissions().mode() & 0o111 != 0,
+        "Termux codex-code-mode-host is not an executable regular file"
+    );
+    Ok(())
+}
