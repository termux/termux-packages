+    let root = prepare_shared_daemon_socket_directory().expect("private Android socket root");
+    let expected = format!("@TERMUX_BASE_DIR@/cdx-{}", unsafe { libc::geteuid() });
+    assert_eq!(root, std::path::PathBuf::from(expected));
+    // This is an isolated test endpoint, not a production daemon socket.
+    let path = root.join(format!("p{:063x}.sock", std::process::id()));
+    assert!(path.as_os_str().len() < 108);
+    let mut listener = UnixListener::bind(&path)
+        .await
+        .expect("bind full-length socket");
+    let client = UnixStream::connect(&path)
+        .await
+        .expect("connect full-length socket");
+    let _peer = listener.accept().await.expect("accept full-length socket");
+    drop(client);
+    drop(listener);
+    std::fs::remove_file(path).expect("remove isolated test endpoint");
+}
