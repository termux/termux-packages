+//! Advisory file locking that also works on Android.
+//!
+//! `std::fs::File::{lock, lock_shared, try_lock, try_lock_shared}` are not
+//! implemented by the standard library on Android and always fail with
+//! `ErrorKind::Unsupported`. Bionic does provide `flock(2)`, so on Android
+//! these helpers call it directly. On every other platform they simply
+//! forward to the standard library.
+
+use std::fs::File;
+use std::fs::TryLockError;
+use std::io;
+
+pub trait FileLockExt {
+    /// Blocks until an exclusive lock is acquired.
+    fn lock_compat(&self) -> io::Result<()>;
+    /// Blocks until a shared lock is acquired.
+    fn lock_shared_compat(&self) -> io::Result<()>;
+    /// Tries to acquire an exclusive lock without blocking.
+    fn try_lock_compat(&self) -> Result<(), TryLockError>;
+    /// Tries to acquire a shared lock without blocking.
+    fn try_lock_shared_compat(&self) -> Result<(), TryLockError>;
+}
+
+#[cfg(not(target_os = "android"))]
+impl FileLockExt for File {
+    fn lock_compat(&self) -> io::Result<()> {
+        self.lock()
+    }
+
+    fn lock_shared_compat(&self) -> io::Result<()> {
+        self.lock_shared()
+    }
+
+    fn try_lock_compat(&self) -> Result<(), TryLockError> {
+        self.try_lock()
+    }
+
+    fn try_lock_shared_compat(&self) -> Result<(), TryLockError> {
+        self.try_lock_shared()
+    }
+}
+
+#[cfg(target_os = "android")]
+mod android {
+    use super::*;
+    use std::os::fd::AsRawFd;
+
+    pub(super) fn flock(file: &File, operation: libc::c_int) -> io::Result<()> {
+        loop {
+            // SAFETY: `file` owns a valid open file descriptor for the call.
+            let result = unsafe { libc::flock(file.as_raw_fd(), operation) };
+            if result == 0 {
+                return Ok(());
+            }
+            let err = io::Error::last_os_error();
+            if err.kind() != io::ErrorKind::Interrupted {
+                return Err(err);
+            }
+        }
+    }
+
+    pub(super) fn try_flock(file: &File, operation: libc::c_int) -> Result<(), TryLockError> {
+        match flock(file, operation | libc::LOCK_NB) {
+            Ok(()) => Ok(()),
+            Err(err) if err.raw_os_error() == Some(libc::EWOULDBLOCK) => {
+                Err(TryLockError::WouldBlock)
+            }
+            Err(err) => Err(TryLockError::Error(err)),
+        }
+    }
+}
+
+#[cfg(target_os = "android")]
+impl FileLockExt for File {
+    fn lock_compat(&self) -> io::Result<()> {
+        android::flock(self, libc::LOCK_EX)
+    }
+
+    fn lock_shared_compat(&self) -> io::Result<()> {
+        android::flock(self, libc::LOCK_SH)
+    }
+
+    fn try_lock_compat(&self) -> Result<(), TryLockError> {
+        android::try_flock(self, libc::LOCK_EX)
+    }
+
+    fn try_lock_shared_compat(&self) -> Result<(), TryLockError> {
+        android::try_flock(self, libc::LOCK_SH)
+    }
+}
