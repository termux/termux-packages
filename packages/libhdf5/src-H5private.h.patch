Bionic has no pthread_setcancelstate, so use the no-op thread cancellation macros on Android.

--- a/src/H5private.h
+++ b/src/H5private.h
@@ -1150,7 +1150,7 @@ extern char H5_lib_vers_info_g[];
 #ifdef H5_HAVE_THREADS
 
 /* Thread cancellation is only possible w/pthreads */
-#if defined(H5_HAVE_PTHREAD_H)
+#if defined(H5_HAVE_PTHREAD_H) && !defined(__ANDROID__)
 
 /* Local variable for saving cancellation state */
 #define H5CANCEL_DECL_REAL int oldstate = 0;
