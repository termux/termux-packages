+static void vtest_server_setup_epoxy_paths(void)
+{
+   if (!g_vrend_android_mode) {
+      epoxy_set_library_paths(TERMUX_PREFIX "/lib/libEGL.so.1",
+                              TERMUX_PREFIX "/lib/libGLESv1_CM.so.1",
+                              TERMUX_PREFIX "/lib/libGLESv2.so.2",
+                              TERMUX_PREFIX "/lib/libGL.so.1");
+      return;
+   }
+
+   const char *variant = server.angle_variant ? server.angle_variant : "gl";
+   char egl_path[PATH_MAX], gles1_path[PATH_MAX], gles2_path[PATH_MAX];
+
+   snprintf(egl_path, sizeof(egl_path),
+            TERMUX_PREFIX "/opt/angle-android/%s/libEGL_angle.so", variant);
+   snprintf(gles1_path, sizeof(gles1_path),
+            TERMUX_PREFIX "/opt/angle-android/%s/libGLESv1_CM_angle.so", variant);
+   snprintf(gles2_path, sizeof(gles2_path),
+            TERMUX_PREFIX "/opt/angle-android/%s/libGLESv2_angle.so", variant);
+   /* ANGLE provides no desktop GL; GLX_LIB/OPENGL_LIB stay at their
+    * compiled-in defaults so a stray desktop-GL context request fails
+    * with the normal "couldn't open" error instead of misresolving. */
+   epoxy_set_library_paths(egl_path, gles1_path, gles2_path, NULL);
+}
