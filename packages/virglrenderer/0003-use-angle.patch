@@ -58,6 +58,15 @@
 EPOXY_PUBLIC bool epoxy_extension_in_string(const char *extension_list,
                                             const char *ext);
 
+/* Termux: override the absolute paths used to dlopen() EGL/GLESv1/GLESv2/GL,
+ * in place of the immutable per-platform EGL_LIB/GLES1_LIB/GLES2_LIB/GLX_LIB
+ * defaults. Pass NULL to leave an individual path at its default. Must be
+ * called before the first real EGL/GL call in the process. */
+EPOXY_PUBLIC void epoxy_set_library_paths(const char *egl_path,
+                                          const char *gles1_path,
+                                          const char *gles2_path,
+                                          const char *gl_path);
+
 EPOXY_END_DECLS
 
 #endif /* EPOXY_COMMON_H */
