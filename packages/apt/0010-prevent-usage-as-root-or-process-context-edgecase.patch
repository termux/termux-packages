--- a/cmdline/apt-key.in
+++ b/cmdline/apt-key.in
@@ -83,11 +83,23 @@ create_gpg_home() {
     chmod 700 "$GPGHOMEDIR"
 }
 
-requires_root() {
-	if [ ! -d "@TERMUX_PREFIX@" ] && [ "$(id -u)" -ne 0 ]; then
-		apt_error "This command can only be used by root."
-		exit 1
-	fi
+assert_no_root_or_process_context_edgecase() {
+    if [ "$(id -u)" = "0" ]; then
+        apt_error "Ability to run this command as root has been disabled for safety purposes."
+        exit 1
+    fi
+
+    local se_process_context se_enforcing_status
+    se_process_context="$(cat "/proc/self/attr/current")" || true
+    se_enforcing_status="$(@TERMUX_PREFIX@/libexec/termux/apt-key_selinux_helper)" || true
+    if [ -n "$se_process_context" ] && [ "$se_enforcing_status" = "enforcing" ]; then
+        case "$se_process_context" in
+            "u:r:shell:s0"|"u:r:su:s0"|"u:r:ksu:s0"|"u:r:magisk:s0")
+                apt_error "Ability to run this command from a process context that does not have MCS categories while SELinux is Enforcing has been disabled for safety purposes."
+                exit 1
+                ;;
+        esac
+    fi
 }
 
