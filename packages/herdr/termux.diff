+    #[test]
+    fn identify_agent_in_android_runtime_argv() {
+        type RuntimeCase<'a> = (&'a str, Option<&'a str>, &'a [&'a str], Option<Agent>);
+        let node = "@TERMUX_PREFIX@/bin/node";
+        let codex = "@TERMUX_PREFIX@/bin/codex";
+        let not_agent = "@TERMUX_PREFIX@/tmp/not-an-agent.js";
+        let node_js = "@TERMUX_PREFIX@/tmp/node.js";
+        let cases: &[RuntimeCase<'_>] = &[
+            (
+                "MainThread",
+                None,
+                &["node", node, codex],
+                Some(Agent::Codex),
+            ),
+            ("MainThread", None, &["node", node, not_agent, codex], None),
+            ("MainThread", None, &["node", node_js, codex], None),
+            ("MainThread", None, &[node_js, codex], None),
+            ("node.js", None, &["node.js", codex], None),
+            ("MainThread", Some(node_js), &[node_js, codex], None),
+            ("node", None, &["bun", node, codex], None),
+            ("MainThread", Some(node), &["bun", node, codex], None),
+            ("MainThread", None, &["node", "bun", codex], None),
+            ("MainThread", None, &["node", node, node, codex], None),
+            ("MainThread", None, &["node", "-e", "codex", codex], None),
+            (
+                "MainThread",
+                None,
+                &["python3.12", "-m", "codex", codex],
+                None,
+            ),
+            ("MainThread", None, &["bash", "-c", "codex", codex], None),
+            ("MainThread", None, &["pwsh", "-enc", "codex", codex], None),
+            ("MainThread", Some(node), &[node, codex], Some(Agent::Codex)),
+            (
+                "MainThread",
+                None,
+                &["NODE.EXE", node, codex],
+                Some(Agent::Codex),
+            ),
+            (
+                "MainThread",
+                None,
+                &["node", "--require", not_agent, codex],
+                Some(Agent::Codex),
+            ),
+        ];
+
+        for &(name, argv0, argv, expected) in cases {
+            let mut process = foreground_process(17_024, name, argv);
+            process.argv0 = argv0.map(str::to_string);
+            let job = crate::platform::ForegroundJob {
+                process_group_id: 17_024,
+                processes: vec![process],
+            };
+            assert_eq!(
+                identify_agent_in_job(&job),
+                expected.map(|agent| (agent, "codex".to_string())),
+                "name={name:?}, argv0={argv0:?}, argv={argv:?}"
+            );
+        }
+    }
+
+    #[test]
+    fn runtime_script_suffixes_are_rejected_at_every_ingress() {
+        for runtime in ["node", "bun", "python3.12", "bash", "cmd", "pwsh"] {
+            for suffix in [".js", ".cmd", ".bat", ".ps1", ".exe.js", ".js.exe"] {
+                let script = format!("@TERMUX_PREFIX@/tmp/{runtime}{suffix}");
+                assert_eq!(runtime_executable_name(&script), None);
+                assert!(!is_generic_runtime_or_shell(&script));
+                let argv = [script.as_str(), "@TERMUX_PREFIX@/bin/codex"];
+                let owned_argv: Vec<String> = argv.iter().map(|arg| (*arg).to_string()).collect();
+                assert_eq!(
+                    wrapped_agent_name_from_runtime_argv(&script, Some(&owned_argv)),
+                    None
+                );
+                for (name, argv0) in [
+                    (script.as_str(), None),
+                    ("MainThread", Some(script.as_str())),
+                    ("MainThread", None),
+                ] {
+                    let mut process = foreground_process(17_024, name, &argv);
+                    process.argv0 = argv0.map(str::to_string);
+                    let job = crate::platform::ForegroundJob {
+                        process_group_id: 17_024,
+                        processes: vec![process],
+                    };
+                    assert_eq!(
+                        identify_agent_in_job(&job),
+                        None,
+                        "name={name:?}, argv0={argv0:?}, argv={argv:?}"
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn runtime_executable_normalization_preserves_versioned_python() {
+        for runtime in ["python", "python3", "python3.12", "python3.12.exe"] {
+            let normalized = runtime.strip_suffix(".exe").unwrap_or(runtime);
+            assert_eq!(
+                runtime_executable_name(runtime).as_deref(),
+                Some(normalized)
+            );
+            let job = crate::platform::ForegroundJob {
+                process_group_id: 17_024,
+                processes: vec![foreground_process(
+                    17_024,
+                    "MainThread",
+                    &[runtime, runtime, "/tmp/hermes"],
+                )],
+            };
+            assert_eq!(
+                identify_agent_in_job(&job),
+                Some((Agent::Hermes, "hermes".to_string()))
+            );
+        }
+        for runtime in ["python3.", "python.3", "python3..12", "python3.12x"] {
+            assert_eq!(runtime_executable_name(runtime), None);
+        }
+    }
+
