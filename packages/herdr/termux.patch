+    fn identify_agent_in_android_runtime_argv() {
+        type RuntimeCase<'a> = (&'a str, Option<&'a str>, &'a [&'a str], Option<Agent>);
+        let node = "/data/data/com.termux/files/usr/bin/node";
+        let codex = "/data/data/com.termux/files/usr/bin/codex";
+        let cases: &[RuntimeCase<'_>] = &[
+            (
+                "MainThread",
+                None,
+                &["node", node, codex],
+                Some(Agent::Codex),
+            ),
+            (
+                "MainThread",
+                None,
+                &["node", node, "/tmp/not-an-agent.js", codex],
+                None,
+            ),
+            ("MainThread", None, &["node", "/tmp/node.js", codex], None),
+            ("MainThread", None, &["/tmp/node.js", codex], None),
+            ("node.js", None, &["node.js", codex], None),
+            (
+                "MainThread",
+                Some("/tmp/node.js"),
+                &["/tmp/node.js", codex],
+                None,
+            ),
+        ];
+
+        for &(name, argv0, argv, expected) in cases {
+            let mut process = foreground_process(17_024, name, argv);
+            process.argv0 = argv0.map(str::to_string);
+            let job = crate::platform::ForegroundJob {
+                process_group_id: 17_024,
+                processes: vec![process],
+            };
+            assert_eq!(
+                identify_agent_in_job(&job),
+                expected.map(|agent| (agent, "codex".to_string())),
+                "name={name:?}, argv0={argv0:?}, argv={argv:?}"
+            );
+        }
+
+        let mismatched_runtime_job = crate::platform::ForegroundJob {
+            process_group_id: 17_024,
+            processes: vec![foreground_process(17_024, "node", &["bun", node, codex])],
+        };
+        assert_eq!(identify_agent_in_job(&mismatched_runtime_job), None);
+    }
+
