+\function{zlib_deflate}
+\synopsis{Compress a string}
+\usage{zstr = zlib_deflate (str)}
+\description
+\qualifiers
+\qualifier{level=val}{}
+\qualifier{method=val}{}
+\qualifier{wbits=val}{}
+\qualifier{memlevel=val}{}
+\qualifier{strategy=val}{}
+\example
