diff --git a/lib/dpkg/atomic-file.c b/lib/dpkg/atomic-file.c
index 6fb5bb4..5221e4f 100644
--- a/lib/dpkg/atomic-file.c
+++ b/lib/dpkg/atomic-file.c
@@ -98,8 +98,14 @@ atomic_file_backup(struct atomic_file *file)
 
 	if (unlink(name_old) && errno != ENOENT)
 		ohshite(_("cannot remove old backup file '%s'"), name_old);
-	if (link(file->name, name_old) && errno != ENOENT)
+#ifdef __ANDROID__
+	/* Termux: Use rename(2) since Android does not support hardlinks. */
+	if (rename(file->name, name_old) && errno != ENOENT) {
+#else
+	if (link(file->name, name_old) && errno != ENOENT) {
+#endif
 		ohshite(_("cannot create new backup file '%s'"), name_old);
+	}
 
 	free(name_old);
 }
