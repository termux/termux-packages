diff --git a/cmd/cloudflared/android_service.go b/cmd/cloudflared/android_service.go
new file mode 100644
index 00000000..d0b78254
--- /dev/null
+++ b/cmd/cloudflared/android_service.go
@@ -0,0 +1,164 @@
+//go:build android
+
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+
+	homedir "github.com/mitchellh/go-homedir"
+	"github.com/urfave/cli/v2"
+
+	"github.com/cloudflare/cloudflared/cmd/cloudflared/cliutil"
+	"github.com/cloudflare/cloudflared/logger"
+)
+
+const (
+	defaultTermuxPrefix = "@TERMUX_PREFIX@"
+	termuxServiceName   = "cloudflared"
+	termuxSvcRelDir     = "var/service"
+	termuxSvlogRelPath  = "share/termux-services/svlogger"
+	termuxConfigDirName = ".cloudflared"
+)
+
+var createTokenFile = createTokenFileUnix
+
+func runApp(app *cli.App, _ chan struct{}) {
+	app.Commands = append(app.Commands, &cli.Command{
+		Name:  "service",
+		Usage: "Manages the cloudflared Termux runit service",
+		Subcommands: []*cli.Command{
+			{
+				Name:      "install",
+				Usage:     "Install cloudflared as a Termux runit service",
+				ArgsUsage: "[TOKEN]",
+				Description: `
+Installs cloudflared as a runit-managed service using termux-services.
+
+A token may optionally be provided. If a token is provided, it will be written
+to disk in the service configuration directory and the cloudflared service
+configured to use it via the --token-file argument.
+
+If no token is provided, cloudflared will run without the --token-file argument,
+causing it to look for credentials in a configuration file upon startup.`,
+				Action: cliutil.ConfiguredAction(installTermuxService),
+			},
+			{
+				Name:   "uninstall",
+				Usage:  "Uninstall the cloudflared Termux service",
+				Action: cliutil.ConfiguredAction(uninstallTermuxService),
+			},
+		},
+	})
+	_ = app.Run(os.Args)
+}
+
+func termuxPrefix() string {
+	if p := os.Getenv("PREFIX"); p != "" {
+		return p
+	}
+	return defaultTermuxPrefix
+}
+
+func svDir() string {
+	return filepath.Join(termuxPrefix(), termuxSvcRelDir)
+}
+
+func serviceDir() string {
+	return filepath.Join(svDir(), termuxServiceName)
+}
+
+func runScriptPath() string {
+	return filepath.Join(serviceDir(), "run")
+}
+
+func installTermuxService(c *cli.Context) error {
+	log := logger.CreateLoggerFromContext(c, logger.EnableTerminalLog)
+
+	extraArgs := []string{"tunnel", "run"}
+	if c.NArg() > 0 {
+		cd, err := homedir.Dir()
+		if err != nil {
+			return fmt.Errorf("error determining home directory: %w", err)
+		}
+		cfgDir := filepath.Join(cd, termuxConfigDirName)
+
+		defer func() {
+			if err != nil {
+				removeTokenFile(cfgDir, log)
+			}
+		}()
+
+		if err = writeTokenToConfigDir(c, cfgDir); err != nil {
+			return fmt.Errorf("could not write token to configuration directory: %w", err)
+		}
+
+		extraArgs = buildArgsForTokenFile(cfgDir)
+	}
+
+	shell := filepath.Join(termuxPrefix(), "bin", "sh")
+	runContent := fmt.Sprintf("#!%s\nexec cloudflared", shell)
+	for _, arg := range extraArgs {
+		runContent += " " + arg
+	}
+	runContent += "\n"
+
+	runPath := runScriptPath()
+	if err := os.WriteFile(runPath, []byte(runContent), 0o755); err != nil {
+		return fmt.Errorf("write run script to %s: %w", runPath, err)
+	}
+	log.Info().Msgf("Updated run script at %s", runPath)
+
+	svcDir := serviceDir()
+
+	if _, err := exec.LookPath("sv"); err != nil {
+		log.Warn().Msg("sv command not found. Install termux-services: pkg install termux-services")
+		log.Info().Msgf("Service directory: %s", svcDir)
+		log.Info().Msgf("To enable and start: sv-enable %s", termuxServiceName)
+		log.Info().Msgf("To start manually: sv up %s", termuxServiceName)
+	} else {
+		if err := runCommand("sv-enable", termuxServiceName); err != nil {
+			log.Warn().Err(err).Msg("sv-enable failed, trying sv up directly")
+			downFile := filepath.Join(svcDir, "down")
+			_ = os.Remove(downFile)
+			if err := runCommand("sv", "up", termuxServiceName); err != nil {
+				log.Warn().Err(err).Msgf("Could not start %s service", termuxServiceName)
+			}
+		}
+	}
+
+	log.Info().Msg("Termux runit service for cloudflared installed successfully")
+	log.Info().Msgf("Service directory: %s", svcDir)
+	log.Info().Msg("")
+	log.Info().Msg("To ensure the service starts on device boot:")
+	log.Info().Msg("  1. Install Termux:Boot from F-Droid")
+	log.Info().Msg("  2. Create ~/.termux/boot/start-services with:")
+	log.Info().Msg("     #!@TERMUX_PREFIX@/bin/sh")
+	log.Info().Msg("     termux-wake-lock")
+	log.Info().Msg("     exec runsvdir -P @TERMUX_PREFIX@/var/service")
+	log.Info().Msg("  3. Make it executable: chmod +x ~/.termux/boot/start-services")
+	log.Info().Msg("  4. Disable battery optimization for Termux in Android settings")
+
+	return nil
+}
+
+func uninstallTermuxService(c *cli.Context) error {
+	log := logger.CreateLoggerFromContext(c, logger.EnableTerminalLog)
+
+	if _, err := exec.LookPath("sv"); err == nil {
+		_ = runCommand("sv-disable", termuxServiceName)
+		_ = runCommand("sv", "down", termuxServiceName)
+	} else {
+		log.Warn().Msg("sv command not found, skipping service stop")
+	}
+
+	cd, err := homedir.Dir()
+	if err == nil {
+		removeTokenFile(filepath.Join(cd, termuxConfigDirName), log)
+	}
+
+	log.Info().Msg("Termux runit service for cloudflared uninstalled successfully")
+	return nil
+}
