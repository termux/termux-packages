+# Makefile for csh
+PROG = csh
+CC = gcc
+OPT = -O2
+
+CFLAGS = -c \
+	 -Wall \
+	 -DNLS=1 \
+	 -DSHORT_STRINGS=1
+
+LIBS = -lbsd
+
+SRC = alloc.c \
+      char.c \
+      const.c \
+      csh.c \
+      dir.c \
+      dol.c \
+      error.c \
+      exec.c \
+      exp.c \
+      func.c \
+      glob.c \
+      hist.c \
+      init.c \
+      lex.c \
+      misc.c \
+      parse.c \
+      proc.c \
+      sem.c \
+      set.c \
+      str.c \
+      time.c
+OBJ = $(SRC:.c=.o)
+
+all: const.h $(OBJ)
+	$(CC) -o $(PROG) $(OBJ) $(LIBS)
+	strip ./$(PROG)
+
+%.o: %.c
+	$(CC) $(OPT) $(CFLAGS) $<
+
+clean: 
+	rm -f errnum.h const.h ./*.o ./$(PROG)
 
