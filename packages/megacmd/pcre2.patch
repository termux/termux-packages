+string quoteMeta(const string &what)
+{
+    string quoted;
+    for (unsigned char c : what)
+    {
+        if (c == '\0')
+        {
+            quoted += "\\0";
+        }
+        else if (!((c >= 'a' && c <= 'z') ||
+                   (c >= 'A' && c <= 'Z') ||
+                   (c >= '0' && c <= '9') ||
+                   c == '_' || (c & 128)))
+        {
+            quoted += '\\';
+            quoted += c;
+        }
+        else
+        {
+            quoted += c;
+        }
+    }
+    return quoted;
+}
