+// On some Android devices SELinux denies the termios ioctls on the inherited
+// stdio pty, so probe them before trusting stdin/stdout.
+#[cfg(all(unix, target_os = "android"))]
+fn tty_ioctls_allowed(fd: libc::c_int) -> bool {
+	let mut t = [0u8; 64];
+	unsafe { libc::ioctl(fd, libc::TCGETS2, t.as_mut_ptr()) == 0 && libc::ioctl(fd, libc::TCSETS2, t.as_ptr()) == 0 }
+}
+
+#[cfg(all(unix, not(target_os = "android")))]
+fn tty_ioctls_allowed(_fd: libc::c_int) -> bool { true }
+
