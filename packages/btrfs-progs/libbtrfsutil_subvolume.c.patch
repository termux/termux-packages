+#if defined(__ANDROID__)
+__attribute__((weak, visibility("hidden")))
+void *reallocarray(void *ptr, size_t nmemb, size_t size)
+{
+	size_t bytes;
+	if (__builtin_mul_overflow(nmemb, size, &bytes)) {
+		errno = ENOMEM;
+		return NULL;
+	}
+	return realloc(ptr, bytes);
+}
+#endif
