diff -uNr a/src/aaudio/WorkerThreadGroup.h b/src/aaudio/WorkerThreadGroup.h
--- a/src/aaudio/WorkerThreadGroup.h
+++ b/src/aaudio/WorkerThreadGroup.h
@@ -0,0 +1,161 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef OBOE_WORKER_THREAD_GROUP_H_
+#define OBOE_WORKER_THREAD_GROUP_H_
+
+#include <condition_variable>
+#include <functional>
+#include <list>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <tuple>
+#include <utility>
+
+namespace oboe {
+
+// Track library-created workers separately from native close so consumers can
+// explicitly await completion. Independent ownership keeps the group alive
+// through worker stream/parent destruction and the wrapper's return.
+class WorkerThreadGroup final : public std::enable_shared_from_this<WorkerThreadGroup> {
+    struct Worker {
+        std::thread thread;
+        bool ready{false};
+        bool completed{false};
+    };
+    using Workers = std::list<std::unique_ptr<Worker>>;
+
+    std::mutex mMutex;
+    std::condition_variable mCompletion;
+    Workers mWorkers;
+    bool mClosing{false};
+    bool mJoining{false};
+    bool mJoined{false};
+    inline static thread_local WorkerThreadGroup *sCurrentGroup{nullptr};
+    inline static thread_local bool sCompletionRequested{false};
+
+    struct Context {
+        WorkerThreadGroup *previous;
+        explicit Context(WorkerThreadGroup *group) : previous{sCurrentGroup} {
+            sCurrentGroup = group;
+        }
+        ~Context() { sCurrentGroup = previous; }
+    };
+
+    void complete(Worker *current) {
+        Workers retired;
+        {
+            const auto lock = std::lock_guard<std::mutex>{mMutex};
+            for (auto it = mWorkers.begin(); it != mWorkers.end();) {
+                auto candidate = it++;
+                if (candidate->get() != current && (*candidate)->completed)
+                    retired.splice(retired.end(), mWorkers, candidate);
+            }
+        }
+        // Reap before marking this worker complete, so two workers cannot
+        // select one another. The completion flag only permits join; join
+        // itself waits through the old wrapper and its trampoline return.
+        for (auto &worker : retired) worker->thread.join();
+        {
+            const auto lock = std::lock_guard<std::mutex>{mMutex};
+            current->completed = true;
+        }
+    }
+
+public:
+    static bool isWorkerThread() noexcept { return sCurrentGroup != nullptr; }
+    static bool completionRequested() noexcept { return sCompletionRequested; }
+
+    class CompletionScope final {
+        const bool previous{sCompletionRequested};
+    public:
+        CompletionScope() noexcept { sCompletionRequested = true; }
+        ~CompletionScope() { sCompletionRequested = previous; }
+        CompletionScope(const CompletionScope &) = delete;
+        CompletionScope &operator=(const CompletionScope &) = delete;
+    };
+
+    ~WorkerThreadGroup() {
+        // Without an external close, the last wrapper may release this group.
+        // All other wrappers have released their strong group references.
+        // Preserve self-close behavior without destroying a joinable self handle.
+        for (auto &worker : mWorkers) {
+            if (!worker->thread.joinable()) continue;
+            if (worker->thread.get_id() == std::this_thread::get_id())
+                worker->thread.detach();
+            else
+                worker->thread.join();
+        }
+    }
+
+    template<typename Procedure, typename... Args>
+    void launch(Procedure procedure, Args... args) {
+        const auto group = shared_from_this();
+        // This outer owner survives rejection and thread-construction failure.
+        // Final stream/parent/callable captures are destroyed after unlocking.
+        auto payload = std::make_shared<std::tuple<Procedure, std::tuple<Args...>>>(
+            std::move(procedure), std::make_tuple(std::move(args)...));
+        auto worker = std::make_unique<Worker>();
+        auto *record = worker.get();
+        {
+            const auto lock = std::lock_guard<std::mutex>{mMutex};
+            if (mClosing) return;
+            mWorkers.push_back(std::move(worker));
+            try {
+                record->thread = std::thread([group, payload, record]() mutable {
+                    {
+                        auto lock = std::unique_lock<std::mutex>{group->mMutex};
+                        group->mCompletion.wait(lock, [record]{ return record->ready; });
+                    }
+                    const auto context = Context{group.get()};
+                    std::apply(std::get<0>(*payload), std::move(std::get<1>(*payload)));
+                    // Keep TLS and group ownership through all stream/parent
+                    // capture destruction, including reentrant self-close.
+                    payload.reset();
+                    group->complete(record);
+                });
+            } catch (...) {
+                mWorkers.pop_back();
+                throw;
+            }
+        }
+        // Drop the launcher's protective payload reference before the wrapper
+        // can run. Its completion mark must follow final payload destruction.
+        payload.reset();
+        {
+            const auto lock = std::lock_guard<std::mutex>{mMutex};
+            record->ready = true;
+        }
+        mCompletion.notify_all();
+        // Joining here could deadlock native close waiting for this native
+        // callback to return. Finished handles are reaped by worker completion.
+    }
+
+    void disable() {
+        const auto lock = std::lock_guard<std::mutex>{mMutex};
+        mClosing = true;
+    }
+
+    void join() {
+        // Workers may close each other's streams. Joining from any Oboe
+        // worker can form a reciprocal wait; explicit completion is external.
+        if (sCurrentGroup != nullptr) return;
+        Workers pending;
+        {
+            auto lock = std::unique_lock<std::mutex>{mMutex};
+            mCompletion.wait(lock, [this]{ return !mJoining; });
+            if (mJoined) return;
+            mJoining = true;
+            pending.splice(pending.end(), mWorkers);
+        }
+        for (auto &worker : pending) worker->thread.join();
+        {
+            const auto lock = std::lock_guard<std::mutex>{mMutex};
+            mJoined = true;
+            mJoining = false;
+        }
+        mCompletion.notify_all();
+    }
+};
+
+} // namespace oboe
+#endif // OBOE_WORKER_THREAD_GROUP_H_
