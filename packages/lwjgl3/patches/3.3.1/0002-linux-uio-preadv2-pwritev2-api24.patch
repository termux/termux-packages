+/*
+ * Bionic only declares preadv2()/pwritev2() for API level 33+, but the
+ * Termux toolchain targets API 24. Fall back to preadv()/pwritev() when no
+ * flags are requested, and to the raw syscall otherwise.
+ */
+static ssize_t lwjgl_termux_preadv2(int fd, const struct iovec *iov, int count, off_t offset, int flags) {
+    if (flags == 0 && offset != -1) {
+        return preadv(fd, iov, count, offset);
+    }
+#if defined(__NR_preadv2)
+    return syscall(__NR_preadv2, fd, iov, count, (long)offset, (long)(((uint64_t)offset) >> 32), flags);
+#else
+    errno = ENOSYS;
+    return -1;
+#endif
+}
+
+static ssize_t lwjgl_termux_pwritev2(int fd, const struct iovec *iov, int count, off_t offset, int flags) {
+    if (flags == 0 && offset != -1) {
+        return pwritev(fd, iov, count, offset);
+    }
+#if defined(__NR_pwritev2)
+    return syscall(__NR_pwritev2, fd, iov, count, (long)offset, (long)(((uint64_t)offset) >> 32), flags);
+#else
+    errno = ENOSYS;
+    return -1;
+#endif
+}
 
