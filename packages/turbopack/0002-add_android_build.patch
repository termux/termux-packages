+                    LockfileInner {
+                        file,
+                        path: path.into(),
+                    },
+                ))))))
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                Ok(None)
+            }
+            Err(e) => {
+                Err(e.into())
+            }
+        }
