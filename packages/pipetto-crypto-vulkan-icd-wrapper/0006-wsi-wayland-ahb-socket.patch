+static int wsi_wl_ahb_state;
+
+struct wsi_wl_ahb_probe {
+   bool done;
+   bool created;
+};
+
+static void
+wsi_wl_ahb_probe_created(void *data,
+                         struct zwp_linux_buffer_params_v1 *params,
+                         struct wl_buffer *buffer)
+{
+   struct wsi_wl_ahb_probe *probe = data;
+
+   probe->done = true;
+   probe->created = true;
+   wl_buffer_destroy(buffer);
+}
+
+static void
+wsi_wl_ahb_probe_failed(void *data,
+                        struct zwp_linux_buffer_params_v1 *params)
+{
+   struct wsi_wl_ahb_probe *probe = data;
+
+   probe->done = true;
+}
+
+static const struct zwp_linux_buffer_params_v1_listener wsi_wl_ahb_probe_listener = {
+   .created = wsi_wl_ahb_probe_created,
+   .failed = wsi_wl_ahb_probe_failed,
+};
+
+static bool
+wsi_wl_ahb_serve(struct wl_display *wl_display, int sock,
+                 AHardwareBuffer *ahb, int timeout_ms)
+{
+   struct pollfd pfd = { .fd = sock, .events = POLLIN };
+   char request;
+
+   wl_display_flush(wl_display);
+   return poll(&pfd, 1, timeout_ms) > 0 &&
+          read(sock, &request, 1) == 1 &&
+          AHardwareBuffer_sendHandleToUnixSocket(ahb, sock) == 0;
+}
+
+/* Checks once per process whether the compositor accepts AHardwareBuffer
+ * handles passed over a socket in place of dma-buf file descriptors.
+ */
+static bool
+wsi_wl_ahb_supported(struct wsi_wl_display *display)
+{
+   if (wsi_wl_ahb_state)
+      return wsi_wl_ahb_state > 0;
+
+   struct wsi_wl_ahb_probe probe = {0};
+   AHardwareBuffer *ahb = NULL;
+   AHardwareBuffer_Desc desc = {
+      .width = 16,
+      .height = 16,
+      .layers = 1,
+      .format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM,
+      .usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+               AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER |
+               AHARDWAREBUFFER_USAGE_CPU_READ_RARELY |
+               AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN,
+   };
+   int sock[2] = { -1, -1 };
+   bool acked = false;
+
+   if (AHardwareBuffer_allocate(&desc, &ahb) == 0 &&
+       socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sock) == 0) {
+      struct zwp_linux_buffer_params_v1 *params =
+         zwp_linux_dmabuf_v1_create_params(display->wl_dmabuf);
+
+      AHardwareBuffer_describe(ahb, &desc);
+      zwp_linux_buffer_params_v1_add_listener(params,
+                                              &wsi_wl_ahb_probe_listener,
+                                              &probe);
+      zwp_linux_buffer_params_v1_add(params, sock[1], 0, 0,
+                                     desc.stride * 4, 0, 0);
+      zwp_linux_buffer_params_v1_create(params, 16, 16,
+                                        DRM_FORMAT_ABGR8888, 0);
+      acked = wsi_wl_ahb_serve(display->wl_display, sock[0], ahb, 200);
+      while (!probe.done &&
+             wl_display_dispatch_queue(display->wl_display,
+                                       display->queue) != -1)
+         ;
+      zwp_linux_buffer_params_v1_destroy(params);
+   }
+
+   acked = acked && probe.created;
+
+   for (int i = 0; i < 2; i++) {
+      if (sock[i] >= 0)
+         close(sock[i]);
+   }
+   if (ahb)
+      AHardwareBuffer_release(ahb);
+
+   wsi_wl_ahb_state = acked ? 1 : -1;
+   return acked;
+}
