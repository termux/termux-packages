+static VkResult
+wsi_create_ahardware_buffer_alias_mem(const struct wsi_swapchain *chain,
+                                      const struct wsi_image_info *info,
+                                      struct wsi_image *image)
+{
+   const struct wsi_device *wsi = chain->wsi;
+   VkImage old_image = image->image;
+   VkResult result;
+
+   const native_handle_t *handle = AHardwareBuffer_getNativeHandle(image->ahardware_buffer);
+   AHardwareBuffer_Desc desc;
+   AHardwareBuffer_describe(image->ahardware_buffer, &desc);
+
+   int fd = -1;
+   off_t best = 0;
+   for (int i = 0; handle && i < handle->numFds; i++) {
+      off_t size = lseek(handle->data[i], 0, SEEK_END);
+      if (size > best) {
+         best = size;
+         fd = handle->data[i];
+      }
+   }
+   if (fd < 0) {
+      WRAPPER_LOG(error, "No dma-buf fd in ahardware buffer");
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   const VkSubresourceLayout plane_layout = {
+      .offset = 0,
+      .rowPitch = (VkDeviceSize) desc.stride * 4,
+   };
+   const VkImageDrmFormatModifierExplicitCreateInfoEXT modifier_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT,
+      .drmFormatModifier = 0,
+      .drmFormatModifierPlaneCount = 1,
+      .pPlaneLayouts = &plane_layout,
+   };
+   const VkExternalMemoryImageCreateInfo external_memory_info = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+      .pNext = &modifier_info,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   VkImageCreateInfo image_info = info->create;
+   image_info.pNext = &external_memory_info;
+   image_info.flags &= ~VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+   image_info.tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT;
+
+   result = wsi->CreateImage(chain->device, &image_info,
+                             &chain->alloc, &image->image);
+   if (result != VK_SUCCESS) {
+      WRAPPER_LOG(error, "Failed to create alias image, res %d", result);
+      return result;
+   }
+   wsi->DestroyImage(chain->device, old_image, &chain->alloc);
+
+   VkMemoryRequirements reqs;
+   wsi->GetImageMemoryRequirements(chain->device, image->image, &reqs);
+
+   const VkImportMemoryFdInfoKHR import_fd_info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      .fd = fcntl(fd, F_DUPFD_CLOEXEC, 0),
+   };
+   const VkMemoryDedicatedAllocateInfo dedicated_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .pNext = &import_fd_info,
+      .image = image->image,
+   };
+   const VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &dedicated_info,
+      .allocationSize = best,
+      .memoryTypeIndex = ffs(reqs.memoryTypeBits) - 1,
+   };
+   result = wsi->AllocateMemory(chain->device, &memory_info,
+                                &chain->alloc, &image->memory);
+   if (result != VK_SUCCESS) {
+      WRAPPER_LOG(error, "Failed to import alias image memory, res %d", result);
+      close(import_fd_info.fd);
+      return result;
+   }
+
+   image->num_planes = 1;
+   image->drm_modifier = 1255;
+
+   return VK_SUCCESS;
+}
