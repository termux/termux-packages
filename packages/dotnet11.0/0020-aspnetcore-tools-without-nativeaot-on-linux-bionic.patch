Bundle the aspnetcore SDK tools (dev-certs, user-jwts, user-secrets) without
Native AOT on linux-bionic, as for Mono. The Native AOT aggregate has no SONAME,
so Android's linker can't resolve the shims' versioned symbols, and on x86_64
it needs __tls_get_addr, which bionic only exports from API 29.

diff --git a/src/aspnetcore/eng/Build.props b/src/aspnetcore/eng/Build.props
index e3e3a5569..aa69a35c3 100644
--- a/src/aspnetcore/eng/Build.props
+++ b/src/aspnetcore/eng/Build.props
@@ -188,7 +188,7 @@
                         Condition=" '$(BuildMainlyReferenceProviders)' != 'true' " />
         <DotNetProjects Include="$(RepoRoot)src\Tools\NativeAot\aspnetcoretools\aspnetcoretools.csproj"
                         Exclude="@(ProjectToBuild);@(ProjectToExclude);$(RepoRoot)**\bin\**\*;$(RepoRoot)**\obj\**\*"
-                        Condition=" '$(BuildMainlyReferenceProviders)' != 'true' and '$(DotNetBuildUseMonoRuntime)' != 'true' " />
+                        Condition=" '$(BuildMainlyReferenceProviders)' != 'true' and '$(DotNetBuildUseMonoRuntime)' != 'true' and !$(TargetRuntimeIdentifier.StartsWith('linux-bionic')) " />
         <!-- Only build the composite R2R runtime pack when we will actually ship it -->
         <DotNetProjects Include="$(RepoRoot)src\Framework\App.Runtime\src\aspnetcore-runtime-composite.proj"
                         Condition=" '$(BuildMainlyReferenceProviders)' != 'true' and '$(TargetOsName)' != 'win' " />
diff --git a/src/aspnetcore/src/Tools/NativeAot/aspnetcoretools/aspnetcoretools.csproj b/src/aspnetcore/src/Tools/NativeAot/aspnetcoretools/aspnetcoretools.csproj
